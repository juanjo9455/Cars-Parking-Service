@model List<CarsParkingService.Models.liquidacion_consulta>
@{
    ViewData["Title"] = "Liquidaciones";
    var usuariosFiltro = ViewBag.UsuariosFiltro as List<usuarios> ?? new();
}

@* Liquidaciones (solo administrador): todas, o filtradas por usuario y fechas (sp_consultarLiquidaciones).
   Los filtros se aplican solos, sin recargar (FilasLiquidaciones). Cada fila abre sus vehículos en una
   ventana (DetalleLiquidacion). Mismo estilo que Despachos y cobros *@
<div class="container mt-4 admin-container">

    <!-- Header -->
    <div class="header">
        <div class="header-info" style="flex-grow: 1;">
            <h2 style="margin: 0;">
                <i class="fa-solid fa-sack-dollar" style="color: #d32f2f;"></i> Liquidaciones
            </h2>
            <p>Todas las liquidaciones de los turnos. Toca una para ver sus vehículos</p>
        </div>

        <a asp-controller="Home" asp-action="Administrador" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Volver al panel
        </a>
    </div>

    <!-- Filtros -->
    <div class="filters-wrapper" id="filtersWrapper">
        <button type="button" class="filters-toggle" id="filtersToggle" aria-expanded="false" aria-controls="filtersPanel" data-no-spinner="true">
            <span><i class="fa-solid fa-filter"></i> Filtros</span>
            <i class="fa-solid fa-chevron-down filters-chevron"></i>
        </button>

        <div class="search-section filters-panel" id="filtersPanel">
            <form method="get" asp-action="Liquidaciones" class="row" id="formFiltrosLiquidaciones">
                @* Todos los usuarios: cualquiera puede llegar a cobrar *@
                <div class="form-group col-md-4 mb-3">
                    <label for="filtroUsuario">Usuario</label>
                    <select id="filtroUsuario" name="usuario" style="width:100%;">
                        <option value="">Todos</option>
                        @foreach (var u in usuariosFiltro)
                        {
                            <option value="@u.id_usuario" selected="@((int?)ViewData["FiltroUsuario"] == u.id_usuario)">@u.nombres @u.apellidos</option>
                        }
                    </select>
                </div>

                <div class="form-group col-md-4 mb-3">
                    <label for="filtroDesde">Desde</label>
                    <input type="date" id="filtroDesde" name="desde" class="form-control"
                           value="@(((DateTime?)ViewData["FiltroDesde"])?.ToString("yyyy-MM-dd"))">
                </div>

                <div class="form-group col-md-4 mb-3">
                    <label for="filtroHasta">Hasta</label>
                    <input type="date" id="filtroHasta" name="hasta" class="form-control"
                           value="@(((DateTime?)ViewData["FiltroHasta"])?.ToString("yyyy-MM-dd"))">
                </div>

                @* Sin botón Buscar: los filtros se aplican solos al cambiarlos (activarFiltrosAutomaticos, site.js) *@
                <div class="col-12 mt-2 d-flex justify-content-end gap-2">
                    <a asp-action="Liquidaciones" class="btn btn-secondary px-4">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <p class="liq-cantidad"><span id="cantidadLiquidaciones">@Model.Count</span> liquidaciones</p>

    <!-- Tabla -->
    <div class="table-container">
        <table class="tabla-liquidaciones">
            <thead>
                <tr>
                    <th>Nº liquidación</th>
                    <th>Fecha</th>
                    <th>Funcionario</th>
                    <th>Total efectivo</th>
                    <th>Total transferencia</th>
                    <th>Total liquidación</th>
                    <th>Cant. vehículos</th>
                </tr>
            </thead>
            <tbody id="tablaLiquidaciones">
                <partial name="_FilasLiquidaciones" model="Model" />
            </tbody>
        </table>
    </div>

    @* Páginas de 25 (script de abajo): las filas ya están todas, solo se muestran de a 25 *@
    <nav class="cps-paginas" id="paginasLiquidaciones" aria-label="Páginas de liquidaciones" hidden>
        <button type="button" class="cps-pag-btn" data-pag="-1" data-no-spinner="true"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i> Anterior</button>
        <span class="cps-pag-info" aria-live="polite"></span>
        <button type="button" class="cps-pag-btn" data-pag="1" data-no-spinner="true">Siguiente <i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
    </nav>
</div>

<partial name="_ModalDetalleLiquidacion" />

@section Scripts {
    <script src="~/js/detalle-liquidacion.js" asp-append-version="true"></script>
    <script>
        (function () {
            const tbody = document.getElementById('tablaLiquidaciones');
            if (!tbody) return;

            // Tocar cualquier parte de la fila abre los vehículos, como su botón: en el celular el botón queda
            // al final de la tabla y habría que desplazarla para verlo
            tbody.addEventListener('click', function (e) {
                const fila = e.target.closest('tr.liq-fila');
                if (!fila || e.target.closest('.liq-btn-vehiculos')) return;

                fila.querySelector('.liq-btn-vehiculos').click();
            });

            // Páginas de 25. Al filtrar se vuelve a la primera
            const POR_PAGINA = 25;
            const paginas = document.getElementById('paginasLiquidaciones');
            let pagina = 1;

            function paginar() {
                const filas = [...tbody.querySelectorAll('tr.liq-fila')];
                const total = Math.max(1, Math.ceil(filas.length / POR_PAGINA));
                pagina = Math.min(Math.max(pagina, 1), total);
                filas.forEach((fila, i) => { fila.hidden = Math.floor(i / POR_PAGINA) !== pagina - 1; });
                paginas.hidden = total === 1;
                paginas.querySelector('.cps-pag-info').textContent = `Página ${pagina} de ${total}`;
                paginas.querySelector('[data-pag="-1"]').disabled = pagina === 1;
                paginas.querySelector('[data-pag="1"]').disabled = pagina === total;
            }

            paginas.addEventListener('click', function (e) {
                const boton = e.target.closest('button[data-pag]');
                if (!boton || boton.disabled) return;
                pagina += Number(boton.dataset.pag);
                paginar();
                tbody.closest('table').scrollIntoView({ block: 'start' });
            });

            paginar();

            // Filtros automáticos: al cambiar uno se piden solo las filas, con los filtros que quedaron en la URL.
            // Si llegan dos respuestas, solo cuenta la del último cambio
            let ultimoPedido = 0;

            async function refrescarFilas() {
                const pedido = ++ultimoPedido;

                try {
                    // redirect 'manual': si la sesión venció, la página de login no termina dentro de la tabla
                    const respuesta = await fetch(`/Home/FilasLiquidaciones${location.search}`, { cache: 'no-store', redirect: 'manual' });
                    if (!respuesta.ok || pedido !== ultimoPedido) return;

                    const html = await respuesta.text();
                    if (pedido !== ultimoPedido) return;

                    tbody.innerHTML = html;
                    document.getElementById('cantidadLiquidaciones').textContent = tbody.querySelectorAll('tr.liq-fila').length;
                    pagina = 1;
                    paginar();
                } catch (error) {
                    console.error('Error al filtrar las liquidaciones:', error);
                }
            }

            activarFiltrosAutomaticos(document.getElementById('formFiltrosLiquidaciones'), refrescarFilas);
        })();
    </script>
}
