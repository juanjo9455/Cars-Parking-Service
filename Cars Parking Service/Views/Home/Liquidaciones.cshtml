@model List<CarsParkingService.Models.liquidacion_consulta>
@{
    ViewData["Title"] = "Liquidaciones";
    var funcionarios = ViewBag.Funcionarios as List<CarsParkingService.Models.funcionario_liquidacion> ?? new();
    var moneda = System.Globalization.CultureInfo.GetCultureInfo("es-CO");
}

@* Liquidaciones (solo administrador): todas, o filtradas por funcionario y fechas
   (sp_consultarLiquidaciones). Cada fila se despliega y muestra sus vehículos (DetalleLiquidacion).
   Mismo estilo que Despachos y cobros *@
<div class="container mt-4 admin-container">

    <!-- Header -->
    <div class="header">
        <div class="header-info" style="flex-grow: 1;">
            <h2 style="margin: 0;">
                <i class="fa-solid fa-sack-dollar" style="color: #d32f2f;"></i> Liquidaciones
            </h2>
            <p>Todas las liquidaciones de los turnos. Toca una para ver sus vehículos</p>
        </div>

        <a asp-controller="Home" asp-action="Administrador" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Volver al panel
        </a>
    </div>

    <!-- Filtros -->
    <div class="filters-wrapper" id="filtersWrapper">
        <button type="button" class="filters-toggle" id="filtersToggle" aria-expanded="false" aria-controls="filtersPanel" data-no-spinner="true">
            <span><i class="fa-solid fa-filter"></i> Filtros</span>
            <i class="fa-solid fa-chevron-down filters-chevron"></i>
        </button>

        <div class="search-section filters-panel" id="filtersPanel">
            <form method="get" asp-action="Liquidaciones" class="row">
                <div class="form-group col-md-4 mb-3">
                    <label for="filtroUsuario">Funcionario</label>
                    <select id="filtroUsuario" name="usuario" style="width:100%;">
                        <option value="">Todos</option>
                        @foreach (var f in funcionarios)
                        {
                            <option value="@f.id_usuario" selected="@((int?)ViewData["FiltroUsuario"] == f.id_usuario)">@f.funcionario</option>
                        }
                    </select>
                </div>

                <div class="form-group col-md-4 mb-3">
                    <label for="filtroDesde">Desde</label>
                    <input type="date" id="filtroDesde" name="desde" class="form-control"
                           value="@(((DateTime?)ViewData["FiltroDesde"])?.ToString("yyyy-MM-dd"))">
                </div>

                <div class="form-group col-md-4 mb-3">
                    <label for="filtroHasta">Hasta</label>
                    <input type="date" id="filtroHasta" name="hasta" class="form-control"
                           value="@(((DateTime?)ViewData["FiltroHasta"])?.ToString("yyyy-MM-dd"))">
                </div>

                <div class="col-12 mt-2 d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-primary px-4">Buscar</button>
                    <a asp-action="Liquidaciones" class="btn btn-secondary px-4">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <p class="liq-cantidad">@Model.Count liquidaciones</p>

    <!-- Tabla -->
    <div class="table-container">
        <table class="tabla-liquidaciones">
            <thead>
                <tr>
                    <th>Nº liquidación</th>
                    <th>Fecha</th>
                    <th>Funcionario</th>
                    <th>Total efectivo</th>
                    <th>Total transferencia</th>
                    <th>Total liquidación</th>
                    <th>Cant. vehículos</th>
                </tr>
            </thead>
            <tbody id="tablaLiquidaciones">
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" style="text-align:center; color:#555;">
                            No hay liquidaciones con estos filtros
                        </td>
                    </tr>
                }

                @foreach (var l in Model)
                {
                    var funcionario = string.IsNullOrWhiteSpace(l.funcionario) ? "—" : l.funcionario;

                    <tr class="liq-fila">
                        <td class="liq-numero">#@l.id_liquidacion</td>
                        <td>@(l.fecha?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        <td>@funcionario</td>
                        <td class="liq-dinero">@l.total_efectivo.ToString("C0", moneda)</td>
                        <td class="liq-dinero">@l.total_transferencias.ToString("C0", moneda)</td>
                        <td class="liq-dinero"><strong>@l.total_liquidado.ToString("C0", moneda)</strong></td>
                        <td>
                            @* Abre la ventana con los vehículos (mismo botón que Estado de turnos) *@
                            <button type="button" class="adm-btn-detalle liq-btn-vehiculos" data-no-spinner="true"
                                    data-id="@l.id_liquidacion"
                                    data-usuario="@funcionario"
                                    data-fecha="@(l.fecha?.ToString("dd/MM/yyyy HH:mm") ?? "—")"
                                    onclick="verDetalleLiquidacion(this)"
                                    aria-label="Ver los @l.total_vehiculos vehículos de la liquidación @l.id_liquidacion">
                                <i class="fa-solid fa-car-side" aria-hidden="true"></i> @l.total_vehiculos
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_ModalDetalleLiquidacion" />

@section Scripts {
    <script src="~/js/detalle-liquidacion.js" asp-append-version="true"></script>
    <script>
        // Tocar cualquier parte de la fila abre los vehículos, como su botón: en el celular el botón queda
        // al final de la tabla y habría que desplazarla para verlo
        document.getElementById('tablaLiquidaciones')?.addEventListener('click', function (e) {
            const fila = e.target.closest('tr.liq-fila');
            if (!fila || e.target.closest('.liq-btn-vehiculos')) return;

            fila.querySelector('.liq-btn-vehiculos').click();
        });
    </script>
}
