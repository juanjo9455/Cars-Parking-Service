@using Microsoft.AspNetCore.Identity
@model IEnumerable<CarsParkingService.Models.ingresos>
@{
    ViewData["Title"] = "Panel de Parqueadero (Key)";
    Layout = "~/Views/Shared/_LayoutKey.cshtml";
    var idRol = Context.Session.GetInt32("id_rol");
}

<link rel="stylesheet" href="~/css/vistakey.css" />

@if (ViewBag.idRol == 1 && ViewBag.MostrarModal == true)
{
    <div class="modal-parqueadero-overlay">

        <div class="modal-parqueadero">

            <div class="modal-header">
                <i class="fa-solid fa-square-parking"></i>
                <h2>Seleccionar Parqueadero</h2>
            </div>

            <p class="modal-texto">
                Selecciona el parqueadero al que deseas acceder para
                visualizar y gestionar los vehículos.
            </p>

            <div class="campo-modal">
                <label for="selectParqueadero">
                    Parqueadero
                </label>

                <select id="selectParqueadero">

                    <option value="" disabled selected hidden>
                        Selecciona un parqueadero
                    </option>
                    @foreach (var parqueadero in ViewBag.Parqueaderos)
                    {

                        <option value="@parqueadero.id_parqueadero">
                            @parqueadero.nombre_parqueadero
                        </option>
                    }

                </select>
            </div>

            <button class="btn-acceder-parqueadero"
                    id="btnAccederParqueadero">

                <i class="fa-solid fa-right-to-bracket"></i>
                Acceder al parqueadero

            </button>

        </div>

    </div>
}


<div class="container mt-4">
    <div class="header">
        <div class="header-info">
            <h2>@ViewData["NombreParqueadero"]</h2>
            <p>Gestión de vehículos en la sucursal</p>
        </div>

        <div class="titulo-rol">

            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.58333 6.25C8.84695 6.25 8.25 6.84695 8.25 7.58333V17C8.25 17.4142 8.58579 17.75 9 17.75C9.41421 17.75 9.75 17.4142 9.75 17V13.25H13.25C15.183 13.25 16.75 11.683 16.75 9.75C16.75 7.817 15.183 6.25 13.25 6.25H9.58333ZM13.25 11.75H9.75V7.75H13.25C14.3546 7.75 15.25 8.64543 15.25 9.75C15.25 10.8546 14.3546 11.75 13.25 11.75Z" fill="#000000"></path>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M15.633 1.25H8.367C7.27486 1.24999 6.40935 1.24999 5.71173 1.30699C4.99834 1.36527 4.39472 1.48688 3.84355 1.76772C2.94978 2.22312 2.22312 2.94978 1.76772 3.84355C1.48688 4.39472 1.36527 4.99834 1.30699 5.71173C1.24999 6.40935 1.24999 7.27485 1.25 8.36699V15.633C1.24999 16.7251 1.24999 17.5906 1.30699 18.2883C1.36527 19.0017 1.48688 19.6053 1.76772 20.1565C2.22312 21.0502 2.94978 21.7769 3.84355 22.2323C4.39472 22.5131 4.99834 22.6347 5.71173 22.693C6.40935 22.75 7.27484 22.75 8.36698 22.75H15.633C16.7252 22.75 17.5906 22.75 18.2883 22.693C19.0017 22.6347 19.6053 22.5131 20.1565 22.2323C21.0502 21.7769 21.7769 21.0502 22.2323 20.1565C22.5131 19.6053 22.6347 19.0017 22.693 18.2883C22.75 17.5906 22.75 16.7252 22.75 15.633V8.36698C22.75 7.27484 22.75 6.40935 22.693 5.71173C22.6347 4.99834 22.5131 4.39472 22.2323 3.84355C21.7769 2.94978 21.0502 2.22312 20.1565 1.76772C19.6053 1.48688 19.0017 1.36527 18.2883 1.30699C17.5906 1.24999 16.7251 1.24999 15.633 1.25ZM4.52453 3.10423C4.829 2.94909 5.21325 2.85271 5.83388 2.80201C6.46327 2.75058 7.26752 2.75 8.4 2.75H15.6C16.7325 2.75 17.5367 2.75058 18.1661 2.80201C18.7867 2.85271 19.171 2.94909 19.4755 3.10423C20.087 3.41582 20.5842 3.913 20.8958 4.52453C21.0509 4.829 21.1473 5.21325 21.198 5.83388C21.2494 6.46327 21.25 7.26752 21.25 8.4V15.6C21.25 16.7325 21.2494 17.5367 21.198 18.1661C21.1473 18.7867 21.0509 19.171 20.8958 19.4755C20.5842 20.087 20.087 20.5842 19.4755 20.8958C19.171 21.0509 18.7867 21.1473 18.1661 21.198C17.5367 21.2494 16.7325 21.25 15.6 21.25H8.4C7.26752 21.25 6.46327 21.2494 5.83388 21.198C5.21325 21.1473 4.829 21.0509 4.52453 20.8958C3.913 20.5842 3.41582 20.087 3.10423 19.4755C2.94909 19.171 2.85271 18.7867 2.80201 18.1661C2.75058 17.5367 2.75 16.7325 2.75 15.6V8.4C2.75 7.26752 2.75058 6.46327 2.80201 5.83388C2.85271 5.21325 2.94909 4.829 3.10423 4.52453C3.41582 3.913 3.913 3.41582 4.52453 3.10423Z" fill="#000000"></path></svg>
            <h2>Key</h2>

        </div>
    </div>

    <p style="color: #857D7B;">Filtrar vehículos</p>
    <div class="search-section mb-4">
        <form method="get" action="@Url.Action("VistaKey", "Home")" class="row">
            <div class="form-group col-md-4 mb-3">
                <label>Placa</label>
                <input type="text" name="placa" value="@ViewData["FiltroPlaca"]" placeholder="Buscar Placa..." style="text-transform: uppercase;">
            </div>

            <div class="form-group col-md-4 mb-3">
                <label>Estado Servicio</label>
                <select name="estado_servicio" style="width:100%;">
                    <option value="">Todos los estados</option>
                    <option value="solicitado" selected="@(ViewData["FiltroEstado"]?.ToString() == "solicitado")">Solicitado (Prioridad)</option>
                    <option value="activo" selected="@(ViewData["FiltroEstado"]?.ToString() == "activo")">Activo</option>
                    <option value="parqueado" selected="@(ViewData["FiltroEstado"]?.ToString() == "parqueado")">Parqueado</option>
                    <option value="despachado" selected="@(ViewData["FiltroEstado"]?.ToString() == "despachado")">Despachado</option>
                </select>
            </div>

            <div class="col-12 mt-2 d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <span class="btn-text">Buscar</span>
                </button>
                <a href="@Url.Action("VistaKey", "Home")" class="btn btn-secondary px-4">
                    <span class="btn-text">Limpiar</span>
                </a>
            </div>
        </form>
    </div>

    <div class="table-container">
        <table class="tabla-key">
            <thead>
                <tr>
                    <th>Placa</th>
                    <th>Estado</th>
                    <th>Valet Asignado</th>
                    <th>Banco Asignado</th>
                    <th>Fecha Ingreso</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var claseAlerta = (item.estado_servicio?.Trim().ToLower() == "solicitado") ? "alerta-solicitado" : "";

                    <tr class="@claseAlerta">
                        <td class="fw-bold" data-label="Placa">@item.placa</td>
                        <td data-label="Estado">
                            <span class="status-badge @(item.estado_servicio == "solicitado" ? "status-pendiente" : item.estado_servicio == "parqueado" ? "status-pagado" : "status-en-uso")">
                                @item.estado_servicio?.ToUpper()
                            </span>
                        </td>
                        <td data-label="Valet Asignado">@(item.Valet?.nombres ?? "N/A")</td>
                        <td data-label="Banco Asignado">@(item.Banco?.nombres ?? "N/A")</td>
                        <td data-label="Fecha Ingreso">@item.fecha_ingreso?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td data-label="Acciones" class="cell-action">

                            <form method="post" action="@Url.Action("ActualizarEstadoKey", "Home")" class="d-inline actions-form">
                                <input type="hidden" name="id_ingreso" value="@item.id_ingreso" />

                                @if (item.estado_servicio != "parqueado" && item.estado_servicio != "despachado" && item.id_valet is not null && item.estado_servicio != "solicitado")
                                {
                                    <button type="submit" name="nuevo_estado" value="parqueado" class="btn-icon btn-icon-success" title="Marcar como Parqueado">
                                        <i class="fa-solid fa-square-parking"></i>
                                    </button>
                                }

                                @if (item.estado_servicio != "despachado" && item.estado_servicio?.Trim().ToLower() == "parqueado" || item.estado_servicio == "solicitado")
                                {
                                    <button type="button"
                                            class="btn-icon btn-icon-warning"
                                            title="Despachar"
                                            onclick="abrirModalDespacho(this)"
                                            data-id-ingreso="@item.id_ingreso"
                                            data-placa="@item.placa"
                                            data-id-valet="@(item.id_valet)">
                                        <i class="fa-solid fa-right-from-bracket"></i>
                                    </button>
                                }
                            </form>

                            <button type="button"
                                    class="btn-icon btn-icon-info"
                                    title="Ver información del vehículo"
                                    onclick="abrirModalInformacionKey(this)"
                                    data-id-ingreso="@item.id_ingreso">
                                <i class="fa-solid fa-circle-info"></i>
                            </button>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center" style="padding: 30px; color:#888;">
                            No se encontraron vehículos.
                        </td>
                    </tr>
                }
            
            </tbody>
        </table>
    </div>
</div>

<!-- Modal despacho -->
<!-- Modal despacho -->
<div class="modal fade" id="modalDespachoKey" tabindex="-1" aria-labelledby="modalDespachoKeyLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-key">

            <!-- HEADER -->
            <div class="modal-header modal-key-header">

                <div class="modal-header-content">

                    <div class="modal-icon-wrap">
                        <i class="fa-solid fa-car-side"></i>
                    </div>

                    <div>
                        <h5 class="modal-title" id="modalDespachoKeyLabel">
                            Confirmar despacho
                        </h5>

                        <p class="modal-subtitle">
                            El vehículo será retirado del parqueadero
                        </p>
                    </div>

                </div>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <!-- BODY -->
            <div class="modal-body modal-key-body">

                <!-- ALERT -->
                <div class="modal-alert">

                    <i class="fa-solid fa-circle-exclamation"></i>

                    <span>
                        Antes de continuar verifica el valet que llevará el vehículo hacia el cliente.
                    </span>

                </div>

                <!-- CARD PLACA -->
                <div class="modal-summary-card">

                    <div class="summary-top">
                        <span class="summary-label">Placa del vehículo</span>
                        <span class="summary-value" id="modalPlacaKey"></span>
                    </div>

                    <div class="summary-status">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        Listo para despacho
                    </div>

                </div>

                <!-- FORM -->
                <form method="post"
                      action="@Url.Action("ActualizarEstadoKey", "Home")"
                      id="formDespachoKey">

                    <input type="hidden"
                           name="id_ingreso"
                           id="modalIdIngresoKey" />

                    <input type="hidden"
                           name="nuevo_estado"
                           value="despachado" />

                    <!-- SELECT -->
                    <div class="modal-field">

                        <label class="form-label">
                            <i class="fa-solid fa-user-tie"></i>
                            Valet asignado
                        </label>

                        <select name="id_valet"
                                id="modalIdValetKey"
                                class="form-select">

                            @if (ViewBag.Valets != null)
                            {
                                foreach (var valet in ViewBag.Valets)
                                {
                                    <option value="@valet.id_usuario">
                                        @valet.nombres
                                    </option>
                                }
                            }

                        </select>

                        <div class="field-hint">
                            <i class="fa-solid fa-circle-info"></i>
                            Selecciona el encargado del despacho.
                        </div>

                    </div>

                    <!-- BOTONES -->
                    <div class="modal-actions-key">

                        <button type="button"
                                class="btn-cancelar"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn-despachar">
                            <i class="fa-solid fa-paper-plane"></i>
                            Confirmar despacho
                        </button>

                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

<!-- Modal información vehículo -->
<div class="info-key-modal" id="modalInfoKey" aria-hidden="true">
    <div class="info-key-modal-card" role="dialog" aria-modal="true" aria-labelledby="infoKeyTitle">
        <div class="info-key-modal-header">
            <div>
                <h5 id="infoKeyTitle">Información del vehículo</h5>
                <p>Detalle completo del ingreso</p>
            </div>
            <button type="button" class="info-key-close" onclick="cerrarModalInfoKey()" aria-label="Cerrar">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="info-key-modal-body">
            <div class="info-key-grid">
                <div class="info-key-item">
                    <span class="info-key-label">Placa</span>
                    <span class="info-key-value" id="infoKeyPlaca"></span>
                </div>

                <div class="info-key-item">
                    <span class="info-key-label">Cliente</span>
                    <span class="info-key-value" id="infoKeyCliente"></span>
                </div>

                <div class="info-key-item">
                    <span class="info-key-label">Valet asignado</span>
                    <span class="info-key-value" id="infoKeyValet"></span>
                </div>

                <div class="info-key-item">
                    <span class="info-key-label">Ubicación del servicio</span>
                    <span class="info-key-value" id="infoKeyUbicacion"></span>
                </div>
            </div>

            <div class="info-key-gallery-wrap">
                <h6>Fotos del vehículo</h6>
                <div class="info-key-gallery" id="infoKeyGallery"></div>
                <div class="info-key-no-photos" id="infoKeyNoPhotos" style="display:none;">
                    No hay fotos registradas para este vehículo.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================
        VISOR DE IMAGEN EN GRANDE
========================================== -->

<div id="visor-imagen" class="visor-imagen" style="display:none;">

    <div class="visor-overlay" onclick="cerrarVisorImagen()"></div>

    <div class="visor-contenido">

        <button class="visor-cerrar"
                type="button"
                onclick="cerrarVisorImagen()">
            &times;
        </button>

        <img id="imagen-grande"
             src=""
             alt="Imagen ampliada">

    </div>

</div>

<script>
    window.vistaKeyInfoMap = @Html.Raw(ViewBag.VistaKeyInfoJson ?? "{}");
</script>

<script>
    window.debugVistaKeyController = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["DebugVistaKey"]?.ToString() ?? string.Empty));
</script>

<script>
    (function () {
        const spinnerSvg = '<svg viewBox="25 25 50 50"><circle r="20" cy="50" cx="50"></circle></svg>';

        const addSpinner = (el) => {
            if (!el || el.dataset.noSpinner === 'true' || el.querySelector('.btn-spinner')) return;
            el.classList.add('btn-loading-target');
            const spinner = document.createElement('span');
            spinner.className = 'btn-spinner';
            spinner.setAttribute('aria-hidden', 'true');
            spinner.innerHTML = spinnerSvg;
            el.appendChild(spinner);
        };

        const getSpinnerColor = (el) => {
            const styles = window.getComputedStyle(el);
            const bg = styles.backgroundColor;
            const values = bg.match(/\d+(?:\.\d+)?/g);

            if (!values || bg === 'transparent') {
                return '#c62828';
            }

            const r = Number(values[0] || 0) / 255;
            const g = Number(values[1] || 0) / 255;
            const b = Number(values[2] || 0) / 255;
            const luminance = (0.2126 * r) + (0.7152 * g) + (0.0722 * b);

            return luminance > 0.72 ? '#c62828' : '#ffffff';
        };

        const activate = (el) => {
            if (!el || el.dataset.noSpinner === 'true') return;
            addSpinner(el);
            el.style.setProperty('--spinner-stroke', getSpinnerColor(el));
            el.classList.add('btn-loading');
            if (el.tagName === 'BUTTON') {
                el.disabled = true;
            }
        };

        document.querySelectorAll('button, a.btn, a.home-action-btn').forEach(addSpinner);

        document.querySelectorAll('form').forEach(form => {
            form.addEventListener('submit', ev => {
                const submitter = ev.submitter || form.querySelector('button[type="submit"], button:not([type])');
                activate(submitter);
            });
        });

        document.querySelectorAll('a.btn, a.home-action-btn').forEach(link => {
            link.addEventListener('click', () => activate(link));
        });
    })();
</script>

<script src="~/js/vistakey.js?v=@DateTime.Now.Ticks"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        if (window.debugVistaKeyController && typeof window.mostrarDebugKeyAlerta === 'function') {
            window.mostrarDebugKeyAlerta(window.debugVistaKeyController, 'server');
        }
    });
</script>
