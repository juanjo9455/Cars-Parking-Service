@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Inicio";
    var nombre = Context.Session.GetString("nombre") ?? "Usuario";
    var idRol = Context.Session.GetInt32("id_rol");
    var primerNombre = nombre.Trim().Split(' ')[0];
    var rolTexto = idRol switch { 1 => "Valet", 2 => "Banco", 3 => "Administrador", 4 => "Key", _ => "" };
    var hoy = DateTime.Now.ToString("dddd d 'de' MMMM", new System.Globalization.CultureInfo("es-CO"));
    hoy = char.ToUpper(hoy[0]) + hoy[1..];
    var linea = ViewBag.Linea as Dictionary<string, int> ?? new();
    var puedeSalir = (ViewBag.estadoLiquidacion as bool?) ?? true;
    var pendientes = (ViewBag.pendientesVehiculos as int?) ?? 0;

    // "Cerrar sesión" desde otra página llega aquí (?salir=1): sin pendientes se cierra; con pendientes, el aviso
    var salir = Context.Request.Query["salir"] == "1";

    // Las estaciones de la línea: estado del ingreso, nombre y qué pide cada una
    var estaciones = new[]
    {
        ("activo", "Recibidos"), ("parqueado", "Parqueados"), ("solicitado", "Solicitados"),
        ("despachado", "Despachados"), ("finalizado", "Pagados hoy")
    };
    string Ico(string n) => $"<svg class=\"ico\" aria-hidden=\"true\" focusable=\"false\"><use href=\"/img/iconos.svg?v=1#i-{n}\"></use></svg>";
}

@if (salir && puedeSalir)
{
    <script>location.replace('@Url.Action("CerrarSesion", "Auth")');</script>
}

@* Inicio del rediseño: quién es, la línea de hoy de su zona y las acciones de su rol *@
<div class="cps-inicio">
    @* El rol va en la línea de datos, junto a la fecha y la zona *@
    <section class="cps-saludo">
        <h1>Hola, @primerNombre</h1>
        <p>
            @rolTexto<span class="cps-sep" aria-hidden="true">·</span>@hoy
            @if (idRol == 2)
            {
                <span class="cps-sep" aria-hidden="true">·</span>@ViewBag.ubicacion
            }
        </p>
    </section>

    @if ((idRol == 2 || idRol == 3) && pendientes > 0)
    {
        <a class="cps-aviso-liquidar" asp-controller="Liquidacion" asp-action="Liquidacion">
            @Html.Raw(Ico("wallet"))
            <span>Tienes <strong>@pendientes vehículo(s)</strong> cobrados sin liquidar. Toca para liquidar.</span>
        </a>
    }

    @* La línea (signature): cada estación con sus carros; tocarla abre la tabla con ese estado *@
    <section class="cps-tablero" aria-labelledby="lineaTitulo">
        <div class="cps-tablero-cabeza">
            <h2 id="lineaTitulo">La línea de hoy</h2>
            <a asp-controller="Home" asp-action="Tabla_Vehiculos">Ver ingresos</a>
        </div>
        <ol class="cps-linea">
            @foreach (var (estado, texto) in estaciones)
            {
                var n = linea.GetValueOrDefault(estado);
                var clase = n == 0 ? "" : estado == "solicitado" ? "con atencion" : estado == "finalizado" ? "con hecho" : "con";
                <li>
                    <a class="cps-estacion @clase" href="@Url.Action("Tabla_Vehiculos", "Home", new { estado_servicio = estado })"
                       aria-label="@texto: @n">
                        <span class="cps-estacion-punto num">@n</span>
                        <span class="cps-estacion-nombre">@texto</span>
                    </a>
                </li>
            }
        </ol>
    </section>

    @* Los carros que piden los clientes: lo primero que hay que atender *@
    @if (linea.GetValueOrDefault("solicitado") is var solicitados && solicitados > 0)
    {
        <a class="cps-solicitados" href="@Url.Action("Tabla_Vehiculos", "Home", new { estado_servicio = "solicitado" })">
            <span class="cps-solicitados-punto" aria-hidden="true"></span>
            <span><strong>@solicitados @(solicitados == 1 ? "carro solicitado" : "carros solicitados")</strong><small>El cliente lo está esperando</small></span>
            @Html.Raw(Ico("chevron-right"))
        </a>
    }

    @* Dos acciones al alcance del pulgar (lo demás está en la barra de abajo y en "Más") *@
    <section class="cps-acciones" aria-label="Acciones rápidas">
        @if (idRol == 2 || idRol == 3)
        {
            <div class="cps-accion principal">
                <a class="cps-accion-link" asp-controller="Home" asp-action="Ingreso_Vehiculos">
                    @Html.Raw(Ico("plus"))
                    <span><strong>Nuevo ingreso</strong><small>Registrar un carro</small></span>
                </a>
                <a class="cps-accion-extra" href="@Url.Action("Ingreso_Vehiculos", "Home", new { escanear = 1 })" aria-label="Nuevo ingreso escaneando la placa" title="Escanear placa">
                    @Html.Raw(Ico("scan-line"))
                </a>
            </div>
        }
        else
        {
            <button type="button" class="cps-accion principal" onclick="abrirPanelSolicitudes()" data-no-spinner="true">
                @Html.Raw(Ico("bell"))
                <span><strong>Solicitudes</strong><small>Carros que piden los clientes</small></span>
            </button>
        }
        <a class="cps-accion" href="@Url.Action("Tabla_Vehiculos", "Home", new { buscar = 1 })">
            @Html.Raw(Ico("search"))
            <span><strong>Buscar placa</strong><small>En los ingresos</small></span>
        </a>
    </section>
</div>

<!-- Notificación estilo Android -->
<div class="android-notif" id="androidNotif">
    <div class="notif-app-bar">
        <div class="notif-app-dot"></div>
        <span class="notif-app-name">Solicitudes Vehículo</span>
        <span class="notif-app-time" id="notifTime">ahora</span>
    </div>
    <div class="notif-body">
        <div class="notif-title" id="notifTitle">Nueva solicitud</div>
        <div class="notif-sub" id="notifSub">Cargando...</div>
    </div>
    <div class="notif-actions">
        <button class="notif-act" onclick="VehiculoBurbuja.dismissNotif()">Ignorar</button>
        <button class="notif-act" onclick="VehiculoBurbuja.openFromNotif()">Ver ahora</button>
    </div>
</div>

<!-- Burbuja ovalada -->
<div class="bubble" id="vehiculoBubble"
     onclick="abrirPanelSolicitudes()"
     role="button" tabindex="0"
     aria-label="Solicitudes de vehículo">
    <i class="fa-solid fa-car-side"></i>
    <span class="bubble-count" id="bubbleCount"></span>
</div>

<!-- Panel principal -->
<div class="req-panel" id="reqPanel" role="dialog" aria-label="Panel de solicitudes">

    <div class="panel-header">
        <div class="panel-header-left">
            <i class="fa-solid fa-car-side"></i>
            Solicitudes de vehículo
        </div>
        <button class="panel-close" onclick="cerrarPanelSolicitudes()" aria-label="Cerrar panel">
            <i class="fa-solid fa-x"></i>
        </button>
    </div>

    <div class="total-banner">
        <div class="total-banner-txt">Total solicitudes hoy</div>
        <div class="total-banner-num" id="totalAcum"></div>
    </div>

    <div class="stats-bar">
        <div class="stat-cell">
            <div class="stat-num red" id="statPend">0</div>
            <div class="stat-lbl">Solicitados</div>
        </div>
        <div class="stat-cell">
            <div class="stat-num green" id="statActv"></div>
            <div class="stat-lbl">Despachado</div>
        </div>
        <div class="stat-cell">
            <div class="stat-num gray" id="statDone">0</div>
            <div class="stat-lbl">Esperando Valet</div>
        </div>
    </div>

    <div class="tabs-nav" role="tablist">
        <button class="tab-btn active" role="tab" aria-selected="true"
                aria-controls="tab-solicitados" id="btn-solicitados"
                onclick="switchTab('solicitados')">
            Solicitados
            <span class="tab-badge" id="badge-solicitados"></span>
        </button>
        <button class="tab-btn" role="tab" aria-selected="false"
                aria-controls="tab-despachados" id="btn-despachados"
                onclick="switchTab('despachados')">
            Despachado
            <span class="tab-badge" id="badge-despachados"></span>
        </button>
        <button class="tab-btn" role="tab" aria-selected="false"
                aria-controls="tab-esperando-valet" id="btn-esperando-valet"
                onclick="switchTab('esperando-valet')">
            Esperando Valet
            <span class="tab-badge" id="badge-esperando-valet"></span>
        </button>
    </div>

    <div class="tab-content active" id="tab-solicitados" role="tabpanel" aria-labelledby="btn-solicitados">
        <div class="panel-list" id="panelPendingList"></div>
        <div class="panel-empty" id="panelEmpty">
            <i class="fa-solid fa-car-side"></i>
            <span>Sin solicitudes en este estado</span>
        </div>
    </div>

    <div class="tab-content" id="tab-despachados" role="tabpanel" aria-labelledby="btn-despachados">
        <div class="panel-list" id="panelActiveList"></div>
        <div class="panel-empty" id="panelEmptyDespachados">
            <i class="fa-solid fa-car-side"></i>
            <span>Sin vehiculos en este estado</span>
        </div>
    </div>

    <div class="tab-content" id="tab-esperando-valet" role="tabpanel" aria-labelledby="btn-esperando-valet">
        <div class="panel-list" id="panelEperandoValetList"></div>
        <div class="panel-empty" id="panelEmptyEsperandoValet">
            <i class="fa-solid fa-car-side"></i>
            <span>Sin vehiculos en este estado</span>
        </div>
    </div>

</div>

<!-- Alerta Liquidacion -->
<div class="liquidacion-alert" id="liquidacionAlert">

    <div class="liquidacion-alert-card">

        <div class="alert-icon">
            <i class="fa-solid fa-circle-check"></i>
        </div>

        <h2>Liquidación completada</h2>

        <p>
            La liquidación se registró correctamente.
            Puede retirarse de su puesto de trabajo.
        </p>

        <button class="alert-btn" onclick="cerrarAlertaLiquidacion()">
            Entendido
        </button>

    </div>

</div>

<!-- Alerta: liquidación pendiente antes de cerrar sesión -->
<div class="liquidacion-alert @(TempData["PendienteLiquidar"] != null || (salir && !puedeSalir) ? "show" : "")" id="alertaPendiente">

    <div class="liquidacion-alert-card">

        <div class="alert-icon" style="background:#FFF3CD; color:#FF9800;">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>

        <h2>Liquidación pendiente</h2>

        <p>
            Tienes <strong>@ViewBag.pendientesVehiculos</strong> vehículo(s) sin liquidar
            en <strong>@ViewBag.pendientesUbicaciones</strong> ubicación(es).
            Debes liquidar antes de cerrar sesión.
        </p>

        <a class="alert-btn" asp-controller="Liquidacion" asp-action="Liquidacion">
            Ir a liquidar
        </a>

        <button class="alert-btn" style="background:#9e9e9e; margin-top:10px;"
                onclick="document.getElementById('alertaPendiente').classList.remove('show')">
            Cerrar
        </button>

    </div>

</div>


@section Scripts {
    <script src="~/js/solicitudes.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {

            const mostrar = sessionStorage.getItem('mostrarAlertaLiquidacion');

            console.log(mostrar); // debe imprimir "true"

            if (mostrar === 'true') {

                const alerta = document.getElementById('liquidacionAlert');

                if (alerta) {
                    alerta.classList.add('show');
                    window.reproducirSonido?.('pago');
                }

            sessionStorage.removeItem('mostrarAlertaLiquidacion');
            }

        });

        function cerrarAlertaLiquidacion() {

            const alerta = document.getElementById('liquidacionAlert');

            if (alerta) {
                alerta.classList.remove('show');
            }
        }
    </script>

    <script>
        (function () {
            const spinnerSvg = '<svg viewBox="25 25 50 50"><circle r="20" cy="50" cx="50"></circle></svg>';

            const addSpinner = (el) => {
                if (!el || el.querySelector('.btn-spinner')) return;
                el.classList.add('btn-loading-target');
                const spinner = document.createElement('span');
                spinner.className = 'btn-spinner';
                spinner.setAttribute('aria-hidden', 'true');
                spinner.innerHTML = spinnerSvg;
                el.appendChild(spinner);
            };

            const getSpinnerColor = (el) => {
                const styles = window.getComputedStyle(el);
                const bg = styles.backgroundColor;
                const values = bg.match(/\d+(?:\.\d+)?/g);

                if (!values || bg === 'transparent') {
                    return '#c62828';
                }

                const r = Number(values[0] || 0) / 255;
                const g = Number(values[1] || 0) / 255;
                const b = Number(values[2] || 0) / 255;
                const luminance = (0.2126 * r) + (0.7152 * g) + (0.0722 * b);

                return luminance > 0.72 ? '#c62828' : '#ffffff';
            };

            const activate = (el) => {
                if (!el) return;
                addSpinner(el);
                el.style.setProperty('--spinner-stroke', getSpinnerColor(el));
                el.classList.add('btn-loading');
                if (el.tagName === 'BUTTON') {
                    el.disabled = true;
                }
            };

            document.querySelectorAll('button, a.btn, a.home-action-btn').forEach(addSpinner);

            document.querySelectorAll('form').forEach(form => {
                form.addEventListener('submit', ev => {
                    const submitter = ev.submitter || form.querySelector('button[type="submit"], button:not([type])');
                    activate(submitter);
                });
            });

            document.querySelectorAll('a.btn, a.home-action-btn').forEach(link => {
                link.addEventListener('click', () => activate(link));
            });
        })();
    </script>

}
