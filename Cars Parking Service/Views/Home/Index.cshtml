        @if (idRol == 3)
        {
            <div class="titulo-rol">

                <i class="fa-solid fa-crown"></i>
                <h2>Administrador</h2>

            </div>
        }

        <div class="home-logo-wrap">
            <img src="~/img/Logo-CarsParkingService.png" alt="Logo Cars Parking" class="home-logo" />
        </div>
        <p class="home-greeting">Bienvenido, @nombre</p>
        
        @if (idRol == 2){

            <h1 class="home-title">@ViewBag.ubicacion</h1>
            <p class="home-greeting">Cars Parking Service</p>

        }
        else{
            
            <h1 class="home-title">Cars Parking Service</h1>
        
        }
        
