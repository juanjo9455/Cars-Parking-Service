@model List<CarsParkingService.Models.ingresos>
@{
    ViewData["Title"] = "Tabla Vehiculos";
    var modalError = TempData["Error"] as string;
    var modalErrorIngresoId = TempData["ErrorIngresoId"]?.ToString();
    var idRol = Context.Session.GetInt32("id_rol");
    var idUsuarioSesion = Context.Session.GetInt32("id");
}

<style>
    .card-ingreso-vehiculos {
        width: 30%;
        max-width: 1100px;
    }

    .card-ingreso-vehiculos .form-group-modal{
        width: 90%;
    }
</style>

<!-- Notificación estilo Android -->
<div class="android-notif" id="androidNotif">
    <div class="notif-app-bar">
        <div class="notif-app-dot"></div>
        <span class="notif-app-name">Solicitudes Vehículo</span>
        <span class="notif-app-time" id="notifTime">ahora</span>
    </div>
    <div class="notif-body">
        <div class="notif-title" id="notifTitle">Nueva solicitud</div>
        <div class="notif-sub" id="notifSub">Cargando...</div>
    </div>
    <div class="notif-actions">
        <button class="notif-act" onclick="VehiculoBurbuja.dismissNotif()">Ignorar</button>
        <button class="notif-act" onclick="VehiculoBurbuja.openFromNotif()">Ver ahora</button>
    </div>
</div>
<!-- Burbuja ovalada -->
<div class="bubble" id="vehiculoBubble"
     onclick="abrirPanelSolicitudes()"
     role="button" tabindex="0"
     aria-label="Solicitudes de vehículo">
    <i class="fa-solid fa-car-side"></i>
    <span class="bubble-count" id="bubbleCount"></span>
</div>

<!-- Panel principal -->
<div class="req-panel" id="reqPanel" role="dialog" aria-label="Panel de solicitudes">

    <div class="panel-header">
        <div class="panel-header-left">
            <i class="fa-solid fa-car-side"></i>
            Solicitudes de vehículo
        </div>
        <button class="panel-close" onclick="cerrarPanelSolicitudes()" aria-label="Cerrar panel">
            <i class="fa-solid fa-x"></i>
        </button>
    </div>

    <div class="total-banner">
        <div class="total-banner-txt">Total solicitudes hoy</div>
        <div class="total-banner-num" id="totalAcum"></div>
    </div>

    <div class="stats-bar">
        <div class="stat-cell">
            <div class="stat-num red" id="statPend">0</div>
            <div class="stat-lbl">Solicitados</div>
        </div>
        <div class="stat-cell">
            <div class="stat-num green" id="statActv"></div>
            <div class="stat-lbl">En curso</div>
        </div>
        <div class="stat-cell">
            <div class="stat-num gray" id="statDone">0</div>
            <div class="stat-lbl">Finalizados</div>
        </div>
    </div>

    <div class="tabs-nav" role="tablist">
        <button class="tab-btn active" role="tab" aria-selected="true"
                aria-controls="tab-solicitados" id="btn-solicitados"
                onclick="switchTab('solicitados')">
            Solicitados
            <span class="tab-badge" id="badge-solicitados"></span>
        </button>
        <button class="tab-btn" role="tab" aria-selected="false"
                aria-controls="tab-encurso" id="btn-encurso"
                onclick="switchTab('encurso')">
            En curso
            <span class="tab-badge" id="badge-encurso"></span>
        </button>
    </div>

    <div class="tab-content active" id="tab-solicitados" role="tabpanel" aria-labelledby="btn-solicitados">

        <div class="panel-list" id="panelPendingList"></div>

        <div class="panel-empty" id="panelEmpty">
            <i class="fa-solid fa-car-side"></i>
            <span>Sin solicitudes en este estado</span>
        </div>

    </div>

    <div class="tab-content" id="tab-encurso" role="tabpanel" aria-labelledby="btn-encurso">

        <div class="panel-list" id="panelActiveList"></div>

        <div class="panel-empty" id="panelEmptyEnCurso">
            <i class="fa-solid fa-car-side"></i>
            <span>Sin vehiculos en este estado</span>
        </div>

    </div>

</div>


<div class="container">
    <!-- Header -->
    <div class="header">
        <div class="header-info">
            <h2>Ingresos - Valet Parking</h2>
            <p>Registro de entradas y salidas del estacionamiento</p>
        </div>

        @if(idRol == 2 || idRol == 3){
        
            <a asp-controller="Home" asp-action="Ingreso_Vehiculos" class="btn btn-nuevo">+ Nuevo Ingreso</a>
         
        }else{
        
            <a asp-controller="" asp-action="" class="btn btn-nuevo hidden" style="display: none;">+ Nuevo Ingreso</a>
        
        }
    </div>

    <!-- Filtro -->
    <p style="color: #857D7B;">Consultar Ingresos</p>
    <div class="filters-wrapper" id="filtersWrapper">
        <button type="button" class="filters-toggle" id="filtersToggle" aria-expanded="false" aria-controls="filtersPanel">
            <span><i class="fa-solid fa-filter"></i> Filtros</span>
            <i class="fa-solid fa-chevron-down filters-chevron"></i>
        </button>

        <div class="search-section filters-panel" id="filtersPanel">
            <form method="get" asp-action="Tabla_Vehiculos" class="row">
                <div class="form-group col-md-2 mb-3">
                    <label>Placa</label>
                    <input type="text" name="placa" value="@ViewData["FiltroPlaca"]" placeholder="Buscar por placa" class="form-control" style="text-transform: uppercase;">
                </div>

                <div class="form-group col-md-3 mb-3">
                    <label>Lugar</label>
                    <select name="lugar" style="width:100%;">
                        <option value="">Todos</option>
                        @if (ViewBag.Ubicaciones != null)
                        {
                            foreach (var u in ViewBag.Ubicaciones)
                            {
                                <option value="@u.nombre_ubicacion" 
                                    selected="@(ViewData["FiltroLugar"]?.ToString() == u.nombre_ubicacion ? "selected" : null)">
                                    @u.nombre_ubicacion
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group col-md-4 mb-3 ms-md-3" style="min-width:220px;">
                    <label>Estado</label>
                    <select name="estado_servicio" style="width:100%;">
                        <option value="">Todos</option>
                        <option value="activo" selected="@(ViewData["FiltroEstadoServicio"]?.ToString() == "activo")">Activo</option>
                        <option value="finalizado" selected="@(ViewData["FiltroEstadoServicio"]?.ToString() == "finalizado")">Finalizado</option>
                        <option value="cancelado" selected="@(ViewData["FiltroEstadoServicio"]?.ToString() == "cancelado")">Cancelado</option>
                    </select>
                </div>

                <div class="form-group col-md-4 mb-3 ms-md-3" style="min-width:220px;">
                    <label>Estado de Pago</label>
                    <select name="estado_pago" style="width:100%;">
                        <option value="">Todos</option>
                        <option value="pendiente" selected="@(ViewData["FiltroEstadoPago"]?.ToString() == "pendiente" ? "selected" : null)">Pendiente</option>
                        <option value="solicitado" selected="@(ViewData["FiltroEstadoPago"]?.ToString() == "solicitado" ? "selected" : null)">Solicitado</option>
                        <option value="pagado" selected="@(ViewData["FiltroEstadoPago"]?.ToString() == "pagado" ? "selected" : null)">Pagado</option>
                    </select>
                </div>

                <div class="form-group col-md-3 mb-3">
                    <label>Parqueadero</label>
                    <select name="parqueadero" style="width:100%;">
                        <option value="">Todos</option>
                        @if (ViewBag.Parqueaderos != null)
                        {
                            foreach (var u in ViewBag.Parqueaderos)
                            {
                                <option value="@u.nombre_parqueadero" 
                                    selected="@(ViewData["FiltroParqueadero"]?.ToString() == u.nombre_parqueadero ? "selected" : null)">
                                    @u.nombre_parqueadero
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group col-md-2 mb-3">
                    <label>Fecha Ingreso</label>
                    <input type="date" id="fechaInicio" name="fechaInicio" value="@(((DateTime?)ViewData["FiltroFechaInicio"])?.ToString("yyyy-MM-dd"))" class="form-control">
                </div>

                <div class="form-group col-md-3 mb-3">
                    <label>Fecha Salida</label>
                    <input type="date" id="fechaFin" name="fechaFin" value="@(((DateTime?)ViewData["FiltroFechaFin"])?.ToString("yyyy-MM-dd"))" class="form-control">
                </div>

                <div class="col-12 mt-2 d-flex justify-content-end gap-2">
                    <button type="submit" id="btnBuscar" class="btn btn-primary px-4">
                        <span class="btn-text">Buscar</span>
                    </button>
                    <a id="btnLimpiar" asp-action="Tabla_Vehiculos" class="btn btn-secondary px-4">
                        <span class="btn-text">Limpiar</span>
                    </a>
                </div>
                <div class="total-registros-filtro">
                    <i class="fa-solid fa-car-side"></i>
                    Total de ingresos realizados:
                    <strong>@ViewBag.TotalRegistros</strong>
                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Placa</th>
                    <th>Lugar</th>
                    <th>Hora Ingreso</th>
                    <th>Hora Salida</th>
                    <th>Estado Pago</th>
                    <th>Estado Servicio</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ingresos in Model)
            {
                    <tr>
                        <td data-label="Placa">@ingresos.placa</td>
                        <td data-label="Lugar">@ingresos.Ubicacion?.nombre_ubicacion</td>
                        <td data-label="Hora Ingreso">@ingresos.fecha_ingreso</td>
                        <td data-label="Hora Salida">@ingresos.fecha_salida</td>

                        @if (ingresos.estado_pago == "pendiente")
                        {
                            <td data-label="Estado Pago">
                                <span class="status-badge status-pendiente">Pendiente</span>
                            </td>
                        }
                        else if (ingresos.estado_pago == "pagado")
                        {
                            <td data-label="Estado Pago">
                                <span class="status-badge status-pagado">Pagado</span>
                            </td>
                        }
                        else if (ingresos.estado_pago == "solicitado")
                        {
                            <td data-label="Estado Pago">
                                <span class="status-badge status-pendiente">Solicitado</span>
                            </td>
                        }

                        <td data-label="Estado Servicio">@ingresos.estado_servicio</td>

                        @if (idRol == 1) // VALET
                        {
                            if (ingresos.id_valet == idUsuarioSesion && !ingresos.foto_estacionamiento)
                            {
                                <td data-label="Acción" class="cell-action">
                                    <i class="fa-solid fa-camera btn-action"
                                       onclick="abrirModalFoto(this)"
                                       data-id-ingreso="@ingresos.id_ingreso"
                                       data-placa="@ingresos.placa"
                                       data-cliente="@ingresos.nombre_cliente"
                                       style="cursor:pointer;"></i>
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                        }
                        else // BANCO Y ADMIN
                        {
                            if (ingresos.estado_pago == "pagado" &&
                                ingresos.estado_servicio == "finalizado")
                            {
                                <td type="button"
                                    class="btn-icon btn-icon-info"
                                    title="Ver Info/Notas"
                                    style="margin-left: 10px;">
                                    <i class="fa-solid fa-circle-info"></i>
                                </td>
                            }
                            else if (ingresos.id_valet is null)
                            {
                                <td>
                                    <button class="alert-btn"
                                            type="button"
                                            onclick="abrirModalValet()">
                                        <i class="fa-solid fa-user"></i>
                                    </button>
                                </td>
                            }
                            else
                            {
                                <td data-label="Acción" class="cell-action">
                                    <i class="fa-solid fa-credit-card btn-action"
                                       onclick="abrirModalPago('@ingresos.id_ingreso', '@ingresos.placa', '@ingresos.nombre_cliente')"
                                       style="cursor:pointer;"></i>
                                </td>
                            }
                        }
                    </tr>
               
                <div id="modal-valet" class="Editar-Ingreso" style="display:none;">

                    <div class="modal-overlay" onclick="cerrarModalValet()"></div>
                        <div class="Card-Ingreso card-ingreso-vehiculos" style=" margin-left: 13cm; margin-top: 2cm;">
                            <form method="post" action="/Home/actualizarValet">
                            
                            <input type="hidden" name="id_ingreso" value="@ingresos.id_ingreso" />

                            <span class="close-btn" onclick="cerrarModalValet()">&times;</span>
                            
                            <h3>Asignar valet al ingreso</h3>

                            <div class="info-auto" style="background: #f9f9f9; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                                <p><strong>Placa:</strong> @ingresos.placa</p>
                                <p><strong>Cliente:</strong> @ingresos.nombre_cliente</p>
                            </div>
                                <div class="input-group">
                                    <select name="id_valet" id="id_valet" style="width:100%;" required>
                                        <option value="">Selecciona un valet</option>
                                        <option value="">Aun sin valet</option>
                                        @foreach (var valet in ViewBag.Valets)
                                        {
                                            <option value="@valet.id_usuario">@valet.nombres @valet.apellidos</option>
                                        }
                
                                        @if (ViewBag.UsuarioSesion?.usuario_rol == 2)
                                        {
                                            <option value="@ViewBag.UsuarioSesion?.IdUsuario">@ViewBag.UsuarioSesion?.nombre @ViewBag.UsuarioSesion?.apellido (banco)</option>
                                        }
                                    </select>
                                    <div class="error-message" id="errorValet" style="display: none;">⚠️ Selecciona un valet</div>
                                </div>
                                <button type="submit" class="ingreso-btn" id="acceder">Asignar</button>
                        </form>
                    </div>

                </div>

                // Modal para tomar foto de parqueo

                    <div id="modal-foto-parqueo" class="Editar-Ingreso" style="display:none;">

                        <div class="modal-overlay" onclick="cerrarModalFoto()"></div>
                        <div class="Card-Ingreso card-ingreso-vehiculos" style=" margin-left: 13cm; margin-top: 2cm;">
                            <form method="post" asp-controller="Home" asp-action="fotoParqueo" id="formFotoParqueo">
                                <input type="hidden" name="id_ingreso" id="fotoIdIngreso" />
                                <input type="hidden" name="fotoBase64" id="fotoBase64" />

                                <span class="close-btn" onclick="cerrarModalFoto()">&times;</span>

                                <h3>Evidencia del parqueo</h3>

                                <div class="info-auto" style="background:#f9f9f9; padding:15px; border-radius:8px; margin-bottom:20px;">
                                    <p><strong>Placa:</strong> <span id="fotoPlaca"></span></p>
                                    <p><strong>Cliente:</strong> <span id="fotoCliente"></span></p>
                                </div>

                                <div style="display:flex; gap:10px; margin-bottom:15px;">
                                    <button type="button" class="photo-btn-2" id="tomarFotoParqueoBtn">
                                        <svg class="camera-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                            <circle cx="12" cy="13" r="4"></circle>
                                        </svg>
                                        Tomar foto
                                    </button>
                                </div>

                                <div class="Media-Preview">
                                    <div class="photos-preview" id="fotoPreviewParqueo"></div>
                                </div>

                                <input type="file" id="cameraInputParqueo" accept="image/*" capture="environment" style="display:none;">
                                <div class="error-message" id="errorFotoParqueo" style="display:none;"></div>
                            </form>
                        </div>

                    </div>

                <!-- MODAL INTERMEDIO DE PAGO -->
                <div id="modal-pago-@ingresos.id_ingreso" class="Editar-Ingreso" style="display:none;">
                    <div class="modal-overlay" onclick="cerrarModalPago('@ingresos.id_ingreso')"></div>
                    <div class="Card-Ingreso card-ingreso-vehiculos">
                        <span class="close-btn" onclick="cerrarModalPago('@ingresos.id_ingreso')">&times;</span>
                        <h3>Pago para Vehículo</h3>

                        <!-- Información del vehículo -->
                        <div class="info-auto" style="background: #f9f9f9; padding: 15px; border-radius: 8px; margin-bottom: 10px;">
                            <p><strong>Placa:</strong> @ingresos.placa</p>
                            <p><strong>Cliente:</strong> @ingresos.nombre_cliente</p>
                            <p style="margin-bottom: 0;"><strong>Método de Pago Actual:</strong> 
                                <span id="metodo-pago-actual-@ingresos.id_ingreso">
                                    @(string.IsNullOrEmpty(ingresos.metodo_pago) ? "No especificado" : ingresos.metodo_pago)
                                </span>
                            </p>
                        </div>
                        <br />
                        <p> Editar Metodo De Pago </p>
                        <select id="metodo-pago-@ingresos.id_ingreso" style="width:100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px; margin-bottom: 20px;">
                                
                            <option value="QR"
                                    selected="@(ingresos.metodo_pago == "QR" ? "selected" : null)">
                                QR
                            </option>

                            <option value="Transferencia"
                                    selected="@(ingresos.metodo_pago == "Transferencia" ? "selected" : null)">
                                Transferencia
                            </option>

                            <option value="Efectivo"
                                    selected="@(ingresos.metodo_pago == "Efectivo" ? "selected" : null)">
                                Efectivo
                            </option>

                        </select>
                        <br />
                        <!-- Generar código de seguridad -->
                        <div id="btn-generar-contenedor-@ingresos.id_ingreso" style="margin-bottom: 20px;">
                            <button type="button" class="btn btn-primary" onclick="generarCodigoSeguridad('@ingresos.id_ingreso')" style="width: 100%; padding: 10px;">
                                <i class="fa-solid fa-key"></i> Generar Código de Seguridad
                            </button>
                        </div>
                        
                        <p id="contador-codigo-@ingresos.id_ingreso"
                                style="margin-top:10px; color:red; font-weight:bold;">
                        </p>

                        <!-- Ingresar código de validación (OCULTO INICIALMENTE) -->
                        <div id="validacion-contenedor-@ingresos.id_ingreso" style="display:none; margin-bottom: 20px;">
                            <div class="form-group-modal" style="margin-bottom: 20px;">
                                <label>Ingresa el código que el cliente confirmó:</label>
                                <input type="text" id="codigo-validacion-@ingresos.id_ingreso" placeholder="Ej: 123456" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px; text-align: center; font-size: 16px; letter-spacing: 5px;" maxlength="6">
                                <button type="button" id="OtroCodigo" class="btn btn-link" onclick="generarCodigoSeguridad('@ingresos.id_ingreso')" style="margin-top: 10px; color: #2e7d32; text-decoration: underline;">
                                    Generar otro código
                                </button>
                            </div>

                            <!-- Botones de validación -->
                            <div class="modal-actions" style="display: flex; gap: 10px;">
                                <button type="button" class="btn btn-secondary" onclick="cerrarModalPago('@ingresos.id_ingreso')" style="flex: 1;">
                                    Cancelar
                                </button>
                                <button type="button" class="btn btn-primary" onclick="validarCodigoYAbrir('@ingresos.id_ingreso', 'modal-@ingresos.id_ingreso')" style="flex: 1;">
                                    <i class="fa-solid fa-check"></i> Validar y Continuar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- MODAL FINAL DE FINALIZACIÓN DE PAGO -->
                <div id="modal-@ingresos.id_ingreso" class="Editar-Ingreso" style="display:none;">
                    <div class="modal-overlay" onclick="cerrarModalFinalizacion('@ingresos.id_ingreso')"></div>
                    <div class="Card-Ingreso card-ingreso-vehiculos">
                        <span class="close-btn" onclick="cerrarModalFinalizacion('@ingresos.id_ingreso')">&times;</span>
                        <h3>Finalizar Servicio de Vehículo</h3>

                        <!-- Información del vehículo -->
                        <div class="info-auto" style="background: #f9f9f9; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                            <p><strong>Placa:</strong> @ingresos.placa</p>
                            <p><strong>Cliente:</strong> @ingresos.nombre_cliente</p>
                            <p><strong>Método de Pago:</strong> <span id="metodo-pago-final-@ingresos.id_ingreso">@(ingresos.metodo_pago ?? "No especificado")</span></p>
                            <p style="margin-bottom: 0;"><strong>Estado Actual:</strong> @ingresos.estado_servicio</p>
                        </div>

                        <!-- Seleccionar estado final -->
                        <div class="form-group-modal" style="margin-bottom: 20px;">
                            <label>Estado del Servicio:</label>
                            <select id="estado-servicio-@ingresos.id_ingreso" style="width:100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
                                <option value="finalizado">Finalizado</option>
                            </select>
                        </div>

                        <!-- Mostrar estado de pago -->
                        <div style="background: #e3f2fd; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                            <p style="margin: 0; color: #1976d2;"><strong>Estado de Pago: PAGADO ✓</strong></p>
                        </div>

                        <!-- Botones de acción -->
                        <div class="modal-actions" style="display: flex; gap: 10px;">
                            <button type="button" class="btn btn-secondary" onclick="cerrarModalFinalizacion('@ingresos.id_ingreso')" style="flex: 1;">
                                Cancelar
                            </button>
                            <button type="button" class="btn btn-success" onclick="finalizarServicio('@ingresos.id_ingreso')" style="flex: 1;">
                                <i class="fa-solid fa-check-circle"></i> Confirmar
                            </button>
                        </div>
                    </div>
                </div>

            }

            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/solicitudes.js" asp-append-version="true"></script>
    <script src="~/js/pago.js" asp-append-version="true"></script>
    <!--<script>
        document.addEventListener('DOMContentLoaded', function () {
            const fechaInicio = document.getElementById('fechaInicio');
            const fechaFin = document.getElementById('fechaFin');
            const urlParams = new URLSearchParams(window.location.search);

            // Solo asignar la fecha de hoy si NO hay parámetros de filtro en la URL
            // Esto permite que los usuarios busquen sin restricción de fecha
            if (!fechaInicio.value && !urlParams.has('placa') && !urlParams.has('lugar') && 
                !urlParams.has('estado_servicio') && !urlParams.has('estado_pago') && 
                !urlParams.has('parqueadero')) {
                const hoy = new Date().toISOString().split('T')[0];
                fechaInicio.value = hoy;
                fechaFin.value = hoy;
            }

            // Cuando se cambia la fecha inicio, la fecha fin se actualiza
            fechaInicio.addEventListener('change', function () {
                fechaFin.value = this.value;
            });

            const filtersWrapper = document.getElementById('filtersWrapper');
            const filtersToggle = document.getElementById('filtersToggle');

            if (filtersWrapper && filtersToggle) {
                filtersToggle.addEventListener('click', function () {
                    const isOpen = filtersWrapper.classList.toggle('open');
                    filtersToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                });
            }

            const modalErrorIngresoId = '@(modalErrorIngresoId ?? string.Empty)';
            if (modalErrorIngresoId) {
