@model List<CarsParkingService.Models.ingresos>
@{
    ViewData["Title"] = "Despachos y cobros";
    var nombres = ViewBag.Nombres as Dictionary<int, string> ?? new Dictionary<int, string>();

    // Nombre de un usuario, o el texto que se indique si no hay
    string Nombre(int? id, string vacio = "—") =>
        id.HasValue ? nombres.GetValueOrDefault(id.Value, "Usuario #" + id) : vacio;

    // Día y hora, para la ventana de información
    string? FechaHora(DateTime? fecha) => fecha?.ToString("dd/MM HH:mm");

    var moneda = System.Globalization.CultureInfo.GetCultureInfo("es-CO");
    var cuentas = (CarsParkingService.Helpers.LiquidacionReglas.Cuentas)ViewBag.Cuentas;
}

@* Despachos y cobros (punto 28, solo administrador): un vehículo por fila con su ingreso, solicitud,
   despacho, cobro y liquidación. Mismo estilo que WhatsApp Enviados *@
<div class="container mt-4 admin-container">

    <!-- Header -->
    <div class="header">
        <div class="header-info" style="flex-grow: 1;">
            <h2 style="margin: 0;">
                <i class="fa-solid fa-receipt" style="color: #d32f2f;"></i> Despachos y cobros
            </h2>
            <p>Vehículos que ingresaron en el período: quién los recibió, parqueó, solicitó, despachó y cobró</p>
        </div>

        <a asp-controller="Home" asp-action="Administrador" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Volver al panel
        </a>
    </div>

    <!-- Filtros -->
    <div class="filters-wrapper" id="filtersWrapper">
        <button type="button" class="filters-toggle" id="filtersToggle" aria-expanded="false" aria-controls="filtersPanel" data-no-spinner="true">
            <span><i class="fa-solid fa-filter"></i> Filtros</span>
            <i class="fa-solid fa-chevron-down filters-chevron"></i>
        </button>

        <div class="search-section filters-panel" id="filtersPanel">
            <form method="get" asp-action="DespachosCobros" class="row">
                <div class="form-group col-md-4 mb-3">
                    <label>Desde</label>
                    <input type="date" name="desde" class="form-control"
                           value="@(((DateTime?)ViewData["FiltroDesde"])?.ToString("yyyy-MM-dd"))">
                </div>

                <div class="form-group col-md-4 mb-3">
                    <label>Hasta</label>
                    <input type="date" name="hasta" class="form-control"
                           value="@(((DateTime?)ViewData["FiltroHasta"])?.ToString("yyyy-MM-dd"))">
                </div>

                <div class="form-group col-md-4 mb-3">
                    <label>Placa</label>
                    <input type="text" name="placa" value="@ViewData["FiltroPlaca"]" placeholder="Buscar por placa"
                           class="form-control" style="text-transform: uppercase;">
                </div>

                @* Usuario y en qué participó: con "Cobró" o "Liquidó" el resumen muestra lo de esa persona *@
                <div class="form-group col-md-4 mb-3">
                    <label>Usuario</label>
                    <select name="usuario" style="width:100%;">
                        <option value="">Todos</option>
                        @foreach (var u in (List<usuarios>)ViewBag.UsuariosFiltro)
                        {
                            <option value="@u.id_usuario" selected="@((int?)ViewData["FiltroUsuario"] == u.id_usuario)">@u.nombres @u.apellidos</option>
                        }
                    </select>
                </div>

                <div class="form-group col-md-4 mb-3">
                    <label>Cómo participó</label>
                    <select name="como" style="width:100%;">
                        @foreach (var (valor, texto) in new[] { ("", "En cualquier paso"), ("ingreso", "Registró el ingreso"), ("recibio", "Recibió (valet)"),
                                                                 ("parqueo", "Parqueó"), ("solicito", "Solicitó"), ("despacho", "Despachó"),
                                                                 ("cobro", "Cobró"), ("liquido", "Liquidó") })
                        {
                            <option value="@valor" selected="@((ViewData["FiltroComo"] as string ?? "") == valor)">@texto</option>
                        }
                    </select>
                </div>

                <div class="col-12 mt-2 d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-primary px-4">Buscar</button>
                    <a asp-action="DespachosCobros" class="btn btn-secondary px-4">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Resumen del período (mismos criterios que la liquidación): arriba los vehículos, abajo el dinero -->
    <div class="wa-resumen dc-resumen">
        <div class="wa-resumen-item">
            <span class="wa-resumen-num">@ViewBag.Vehiculos</span>
            <span class="wa-resumen-lbl">Total vehículos</span>
        </div>
        <div class="wa-resumen-item">
            <span class="wa-resumen-num">@ViewBag.Despachados</span>
            <span class="wa-resumen-lbl">Despachados</span>
        </div>
        <div class="wa-resumen-item wa-ok">
            <span class="wa-resumen-num">@ViewBag.Cobrados</span>
            <span class="wa-resumen-lbl">Cobrados</span>
        </div>
        <div class="wa-resumen-item @(((int)ViewBag.SinLiquidar) > 0 ? "wa-error" : "wa-ok")">
            <span class="wa-resumen-num">@ViewBag.SinLiquidar</span>
            <span class="wa-resumen-lbl">Cobrados sin liquidar</span>
        </div>
        @* Mismas cuentas que la liquidación: 1. transferencias, 2. propinas de QR, 3. efectivo a entregar; el total, aparte *@
        <div class="wa-resumen-item">
            <span class="wa-resumen-num">@cuentas.Transferencias.ToString("C0", moneda)</span>
            <span class="wa-resumen-lbl">Transferencias (QR)</span>
        </div>
        <div class="wa-resumen-item">
            <span class="wa-resumen-num">@((-cuentas.Propinas).ToString("C0", moneda))</span>
            <span class="wa-resumen-lbl">Propinas de QR</span>
        </div>
        <div class="wa-resumen-item @(cuentas.EfectivoAEntregar < 0 ? "wa-error" : "")">
            <span class="wa-resumen-num">@cuentas.EfectivoAEntregar.ToString("C0", moneda)</span>
            <span class="wa-resumen-lbl">Efectivo a entregar</span>
        </div>
        <div class="wa-resumen-item">
            <span class="wa-resumen-num">@cuentas.Total.ToString("C0", moneda)</span>
            <span class="wa-resumen-lbl">Total (vehículos × servicio)</span>
        </div>
    </div>

    @if (cuentas.Diferencia != 0)
    {
        <p class="wa-aviso">
            <i class="fa-solid fa-scale-unbalanced"></i>
            Diferencia de @cuentas.Diferencia.ToString("C0", moneda): transferencias + efectivo a entregar no da el total.
            Revisa los cobros por un valor distinto al servicio.
        </p>
    }

    @if (Model.Count >= 500)
    {
        <p class="wa-aviso">
            <i class="fa-solid fa-circle-info"></i>
            Se muestran los 500 vehículos más recientes. Usa los filtros para acotar la búsqueda.
        </p>
    }

    <!-- Tabla: lo principal de cada vehículo; la placa abre toda la información (despachos-cobros.js) -->
    <p class="dc-ayuda"><i class="fa-solid fa-hand-pointer"></i> Toca la placa para ver toda la información</p>

    <div class="table-container">
        <table class="tabla-despachos">
            <thead>
                <tr>
                    <th>Placa</th>
                    <th>Fecha</th>
                    <th>Cobro</th>
                    <th>Liquidación</th>
                    <th aria-label="Ver información"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" style="text-align:center; color:#555;">
                            No hay vehículos que ingresaran en este período
                        </td>
                    </tr>
                }

                @foreach (var i in Model)
                {
                    var pagado = i.estado_pago == "pagado";

                    // Lo que pagó el cliente con propina (cobros de antes sin total: servicio + propina)
                    var total = (i.total_servicio ?? 0) > 0 ? i.total_servicio!.Value : (i.valor_servicio ?? 0) + (i.valor_propina ?? 0);

                    // En la fila va lo cobrado sin la propina; el lápiz muestra el total, el servicio y la propina
                    var cobradoSinPropina = total - (i.valor_propina ?? 0);
                    var cobro = i.usuario_cobro.HasValue
                        ? Nombre(i.usuario_cobro) + (string.IsNullOrEmpty(i.rol_cobrador) ? "" : $" ({i.rol_cobrador})")
                        : null;

                    // Todo lo del vehículo para la ventana de información (se escribe como texto, no como HTML)
                    var info = System.Text.Json.JsonSerializer.Serialize(new
                    {
                        id = i.id_ingreso,
                        placa = i.placa,
                        ubicacion = i.Ubicacion?.nombre_ubicacion,
                        estado = i.estado_servicio,
                        pagado,
                        liquidacion = i.id_liquidacion,
                        liquidado = i.id_liquidacion.HasValue || i.estado_liquidacion == true,
                        metodo = i.metodo_pago,
                        total = pagado ? total : 0,
                        servicio = i.valor_servicio ?? 0,
                        propina = i.valor_propina ?? 0,
                        tarifa = i.Ubicacion?.valor_servicio ?? i.valor_servicio ?? 0,
                        horaCobro = FechaHora(i.fecha_entrega),
                        cobro,
                        horaSolicitud = FechaHora(i.fecha_solicitud),
                        solicito = i.fecha_solicitud.HasValue ? (i.usuario_solicitud.HasValue ? Nombre(i.usuario_solicitud) : "Cliente, desde su enlace") : null,
                        lugarEntrega = i.lugar_entrega,
                        horaDespacho = i.valet_despacho.HasValue ? FechaHora(i.fecha_salida) : null,
                        despacho = i.valet_despacho.HasValue ? Nombre(i.valet_despacho) : null,
                        horaIngreso = FechaHora(i.fecha_ingreso),
                        recibio = i.id_valet.HasValue ? Nombre(i.id_valet) : null,
                        banco = Nombre(i.id_banco),
                        horaParqueo = FechaHora(i.fecha_parqueo),
                        parqueo = i.usuario_parqueo.HasValue ? Nombre(i.usuario_parqueo) : null,
                        parqueadero = i.Parqueadero?.nombre_parqueadero,
                        cliente = i.nombre_cliente,
                        celular = i.telefono
                    });

                    <tr>
                        <td data-label="Placa">
                            <button type="button" class="ingreso-placa dc-placa-btn" data-info="@info" aria-label="Ver información de @i.placa">@i.placa</button>
                        </td>

                        <td data-label="Fecha">
                            @if (i.fecha_ingreso.HasValue)
                            {
                                <span class="dc-principal">@i.fecha_ingreso.Value.ToString("dd/MM")</span>
                                <span class="dc-detalle">@i.fecha_ingreso.Value.ToString("HH:mm")</span>
                            }
                            else
                            {
                                <span class="dc-vacio">—</span>
                            }
                        </td>

                        <td data-label="Cobro">
                            @if (pagado)
                            {
                                <span class="dc-principal">@cobradoSinPropina.ToString("C0", moneda) · @(i.metodo_pago ?? "Sin método")</span>
                                <span class="dc-detalle">@Nombre(i.usuario_cobro)</span>
                            }
                            else
                            {
                                <span class="dc-vacio">Pendiente</span>
                            }
                        </td>

                        <td data-label="Liquidación">
                            @if (i.id_liquidacion.HasValue)
                            {
                                <span class="status-badge status-pagado">#@i.id_liquidacion</span>
                            }
                            else if (pagado)
                            {
                                <span class="status-badge wa-badge-error">Sin liquidar</span>
                            }
                            else
                            {
                                <span class="dc-vacio">—</span>
                            }
                        </td>

                        @* El lápiz también abre la información (la gente lo reconoce más fácil que la placa) *@
                        <td>
                            <button type="button" class="dc-lapiz-fila" aria-label="Ver información de @i.placa" title="Ver información">
                                <i class="fa-solid fa-pen" aria-hidden="true"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Para guardar los cambios de método y valor (EditarCobro) *@
    @Html.AntiForgeryToken()
</div>

@* Ventana de información: mismo contenedor y estilo que Información del vehículo (tabla de ingresos) *@
<div id="modal-acciones" class="Editar-Ingreso" style="display:none;">
    <div class="modal-overlay" onclick="cerrarModalAcciones()"></div>
    <div class="Card-Ingreso card-ingreso-vehiculos">
        <span class="close-btn" onclick="cerrarModalAcciones()">&times;</span>
        <div id="contenido-modal-acciones"></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/despachos-cobros.js" asp-append-version="true"></script>
}
