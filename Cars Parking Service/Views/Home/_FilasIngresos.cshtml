@using CarsParkingService.Helpers
@model List<CarsParkingService.Models.ingresos>
@{
    // Mismos datos de sesión que usa Tabla_Vehiculos para decidir qué botones ve cada rol
    var idRol = Context.Session.GetInt32("id_rol");
    var idUsuarioSesion = Context.Session.GetInt32("id");

    // Valor de cada ubicación para el título del modal de cobrar, en pesos colombianos
    var valoresUbicacion = ViewBag.ValoresUbicacion as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();
    var moneda = System.Globalization.CultureInfo.GetCultureInfo("es-CO");
}
@* Filas de la tabla de ingresos. Las usan la página y su refresco automático (FilasIngresos, punto 16),
   así los botones salen siempre de las mismas reglas *@

            @foreach (var ingresos in Model){
                var claseAlerta = "";
                if (ingresos.estado_servicio?.Trim().ToLower() == "solicitado")
                {
                    claseAlerta = "alerta-solicitado";
                }
                else if (ingresos.id_valet == null)
                {
                    claseAlerta = "alerta-sin-valet";
                }

                // Quién y a qué hora se solicitó (puntos 26 y 27). Sin usuario = el cliente desde su enlace.
                // Va en la columna Solicitud y, en el celular (donde esa columna no cabe), debajo del estado
                string? quienSolicito = null;
                string? horaSolicitud = null;
                if (ingresos.fecha_solicitud.HasValue)
                {
                    var nombresSolicitud = ViewBag.NombresSolicitud as Dictionary<int, string>;
                    quienSolicito = ingresos.usuario_solicitud.HasValue
                        ? nombresSolicitud?.GetValueOrDefault(ingresos.usuario_solicitud.Value) ?? "Operador"
                        : "Cliente";
                    // Solo la hora si fue hoy; si no, también el día
                    horaSolicitud = ingresos.fecha_solicitud.Value.ToString(ingresos.fecha_solicitud.Value.Date == DateTime.Today ? "HH:mm" : "dd/MM HH:mm");
                }

                <tr class="@claseAlerta">

                    @* La placa va en un span: la celda conserva su relleno y la placa no queda pegada a los bordes *@
                    <td data-label="Placa"><span class="ingreso-placa">@ingresos.placa</span></td>

                    <td data-label="Estado Servicio">
                        <span class="info-chip">@(string.IsNullOrWhiteSpace(ingresos.estado_servicio) ? "—" : ingresos.estado_servicio)</span>
                        @if (quienSolicito != null)
                        {
                            <span class="solicitud-movil">Pidió: @quienSolicito · @horaSolicitud</span>
                        }
                    </td>

                    @* Chips de estado: mismos colores que tenía el panel de información *@
                    <td data-label="Estado Pago">
                        @if (ingresos.estado_pago == "pagado")
                        {
                            <span class="info-chip chip-ok">Pagado</span>
                        }
                        else if (ingresos.estado_pago == "solicitado")
                        {
                            <span class="info-chip chip-pendiente">Solicitado</span>
                        }
                        else
                        {
                            <span class="info-chip chip-pendiente">Pendiente</span>
                        }
                    </td>

                    <td data-label="Solicitud" class="col-solicitud">
                        @if (quienSolicito != null)
                        {
                            <span class="solicitud-quien">@quienSolicito</span>
                            <span class="solicitud-hora">@horaSolicitud</span>
                        }
                        else
                        {
                            <span class="solicitud-vacia">—</span>
                        }
                    </td>

                    <td data-label="Acción" class="cell-action">

                        @* 0. Vehículo sin valet: el valet se lo toma; banco y admin le asignan uno de la lista.
                              Misma regla que valida actualizarValet (IngresoReglas.PuedeRecibirValet) *@
                        @if (IngresoReglas.PuedeRecibirValet(ingresos) && idRol == 1)
                        {
                            <button class="btn-tomar-vehiculo"
                                    type="button"
                                    onclick="abrirModalTomarVehiculo(this)"
                                    data-id="@ingresos.id_ingreso"
                                    data-placa="@ingresos.placa"
                                    data-cliente="@ingresos.nombre_cliente"
                                    data-id-valet="@idUsuarioSesion"
                                    title="Sin valet asignado — disponible para tomar"
                                    aria-label="Tomar vehículo">
                                <span class="btn-tomar-ping"></span>
                                <i class="fa-solid fa-key"></i>
                                <span class="btn-tomar-texto">Tomar vehículo</span>
                            </button>
                        }
                        else if (IngresoReglas.PuedeRecibirValet(ingresos) && (idRol == 2 || idRol == 3))
                        {
                            <button class="btn-tomar-vehiculo"
                                    type="button"
                                    onclick="abrirModalAsignarValet(this)"
                                    data-id="@ingresos.id_ingreso"
                                    data-placa="@ingresos.placa"
                                    data-cliente="@ingresos.nombre_cliente"
                                    title="Sin valet asignado — elegir uno"
                                    aria-label="Asignar valet">
                                <span class="btn-tomar-ping"></span>
                                <i class="fa-solid fa-user-plus"></i>
                                <span class="btn-tomar-texto">Asignar valet</span>
                            </button>
                        }

                        @* 2. Cámara solo para el valet responsable *@
                        @if (ingresos.id_valet == idUsuarioSesion &&
                            !ingresos.foto_estacionamiento &&
                            ingresos.estado_servicio != "solicitado" &&
                            (idRol == 1 || idRol == 3) &&
                            ingresos.estado_servicio != "despachado" &&
                            ingresos.estado_servicio != "finalizado")
                        {
                            <i class="fa-solid fa-camera btn-action btn-foto-ingreso" title="Foto del parqueo"
                                onclick="abrirModalFoto(this)"
                                data-id-ingreso="@ingresos.id_ingreso"
                                data-placa="@ingresos.placa"
                                data-cliente="@ingresos.nombre_cliente"
                                style="cursor:pointer;">
                            </i>
                        }

                        @* 3. Cobrar: solo despachado, con valet de despacho y sin pagar (punto 32).
                              Misma regla que valida FinalizarServicio (IngresoReglas.PuedeCobrar).
                              El valet no cobra: con el QR le muestra al cliente cómo pagar y toma la foto de la
                              transferencia, que el banco encuentra cargada al cobrar *@
                        @if (IngresoReglas.PuedeCobrar(ingresos))
                        {
                            // Si el cliente pagó por su enlace ya dejó el total con propina; si no, se cobra la tarifa de la
                            // ubicación. En los dos casos el banco puede escribir lo que pagó de verdad (abrirModalPago)
                            var tarifa = valoresUbicacion.TryGetValue(ingresos.id_ubicacion, out var valorUbicacion) ? valorUbicacion : (decimal?)null;
                            var pagoPorApp = (ingresos.total_servicio ?? 0) > 0;
                            var valorCobro = (pagoPorApp ? ingresos.total_servicio : tarifa)?.ToString("C0", moneda) ?? "";
                            var tieneFoto = ingresos.foto_transferencia != null ? "true" : "false";

                            if (idRol == 1)
                            {
                                <i class="fa-solid fa-qrcode btn-action btn-pago-ingreso" title="QR de pago"
                                    onclick="abrirModalQrValet(this)"
                                    data-id="@ingresos.id_ingreso"
                                    data-placa="@ingresos.placa"
                                    data-cliente="@ingresos.nombre_cliente"
                                    data-valor="@valorCobro"
                                    data-tiene-foto="@tieneFoto"
                                    style="cursor:pointer;">
                                </i>
                            }
                            else
                            {
                                <i class="fa-solid fa-credit-card btn-action btn-pago-ingreso" title="Cobrar"
                                    onclick="abrirModalPago(this)"
                                    data-id="@ingresos.id_ingreso"
                                    data-placa="@ingresos.placa"
                                    data-cliente="@ingresos.nombre_cliente"
                                    data-metodo-pago="@(ingresos.metodo_pago ?? "No especificado")"
                                    data-estado-servicio="@(ingresos.estado_servicio ?? "No especificado")"
                                    data-valor="@valorCobro"
                                    data-tarifa="@(tarifa?.ToString("0", System.Globalization.CultureInfo.InvariantCulture))"
                                    data-pago-app="@(pagoPorApp ? "true" : "false")"
                                    data-total="@(pagoPorApp ? ingresos.total_servicio?.ToString("0", System.Globalization.CultureInfo.InvariantCulture) : "")"
                                    data-tiene-foto="@tieneFoto"
                                    style="cursor:pointer;">
                                </i>
                            }
                        }

                        @* 4. Información: siempre visible *@
                        <i class="fa-solid fa-info btn-action btn-info-ingreso" title="Ver Informacion"
                            onclick="abrirModalInformacion(this)"
                            data-id-ingreso="@ingresos.id_ingreso"
                            style="cursor:pointer;">
                        </i>
                    </td>
                </tr>
            }
