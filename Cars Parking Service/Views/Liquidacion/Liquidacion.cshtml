@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Liquidacion";
    Layout = "~/Views/Shared/_LayoutLiquidacion.cshtml";
    var nombre = Context.Session.GetString("nombre") ?? "Usuario";
    var idUsuario = Context.Session.GetInt32("id");
    var idRol = Context.Session.GetInt32("id_rol");
    var registros = ViewBag.ingresosLiquidados;

    // Plata con punto de miles ("20.000") sin importar el idioma del servidor
    var pesosCO = System.Globalization.CultureInfo.GetCultureInfo("es-CO");
    string Pesos(decimal valor) => (valor < 0 ? "-$" : "$") + Math.Abs(valor).ToString("N0", pesosCO);

    // Transferencias, propinas, efectivo a entregar y total (LiquidacionReglas.Calcular): lo mismo que se guarda
    var cuentas = (CarsParkingService.Helpers.LiquidacionReglas.Cuentas)ViewBag.cuentas;
}

<div class="page">

    @* Volver al menú: la misma casita de las demás páginas (este layout no carga site.css: el estilo está en Liquidacion.css) *@
    <a asp-controller="Home" asp-action="Index" class="btn-volver-index" aria-label="Volver al inicio">
        <i class="fa-solid fa-house icon-home"></i>
        <i class="fa-solid fa-arrow-left icon-back"></i>
    </a>

    <!-- Header -->
    <div class="header">
        <div class="header-left">
            <h1>Liquidación de turno</h1>
            <p>Resumen de los servicios pendientes por liquidar</p>
        </div>

        <div class="header-right">
            <span class="meta">
                <strong>@DateTime.Now.ToString("dd 'de' MMMM 'de' yyyy")</strong>
            </span>

            <span class="meta">
                Usuario:
                <strong>@nombre</strong>
            </span>

            <span class="badge-pending">
                <i class="fa-solid fa-clock"></i>
                Pendiente de liquidación
            </span>
        </div>
    </div>

    <!-- Total Ingresos -->
    <div class="total-registros-filtro">
        <i class="fa-solid fa-car-side"></i>
        Total de Vehiculos:
        <strong>@ViewBag.totalVehiculos</strong>
    </div>

    <!-- Cuentas, en orden: 1. transferencias (con propinas), 2. propinas, 3. efectivo a entregar; el total, aparte -->
    <div class="cards-row cards-cuentas">

        <div class="stat-card">
            <div class="icon-wrap">
                <i class="fa-solid fa-qrcode"></i>
            </div>
            <div class="slabel">1. Transferencias (QR)</div>
            <div class="sval">@Pesos(cuentas.Transferencias)</div>
            <div class="ssub">Lo que entró a la cuenta, con propinas</div>
        </div>

        <div class="stat-card">
            <div class="icon-wrap">
                <i class="fa-solid fa-hand-holding-dollar"></i>
            </div>
            <div class="slabel">2. Propinas de QR</div>
            <div class="sval">@Pesos(-cuentas.Propinas)</div>
            <div class="ssub">Se le pagan a los valets con el efectivo</div>
        </div>

        <div class="stat-card">
            <div class="icon-wrap">
                <i class="fa-solid fa-money-bill"></i>
            </div>
            <div class="slabel">3. Efectivo a entregar</div>
            <div class="sval">@Pesos(cuentas.EfectivoAEntregar)</div>
            <div class="ssub">Recibido @Pesos(cuentas.EfectivoRecibido) − propinas @Pesos(cuentas.Propinas)</div>
        </div>

        <div class="stat-card highlight">
            <div class="icon-wrap">
                <i class="fa-solid fa-file-invoice-dollar"></i>
            </div>
            <div class="slabel">Total a liquidar</div>
            <div class="sval">@Pesos(cuentas.Total)</div>
            <div class="ssub">@cuentas.Vehiculos vehículos × servicio</div>
        </div>

    </div>

    @if (cuentas.EfectivoAEntregar < 0)
    {
        <div class="alert-y alert-cuenta">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>Faltan <strong>@Pesos(-cuentas.EfectivoAEntregar)</strong> de efectivo para pagar las propinas de QR.</span>
        </div>
    }

    @if (cuentas.Diferencia != 0)
    {
        @* Transferencias + efectivo a entregar no da el total: casi siempre un QR cobrado por menos de la tarifa *@
        <div class="alert-y alert-cuenta">
            <i class="fa-solid fa-scale-unbalanced"></i>
            <span>
                Diferencia: <strong>@Pesos(cuentas.Diferencia)</strong>.
                Transferencias + efectivo a entregar = @Pesos(cuentas.Transferencias + cuentas.EfectivoAEntregar), y el total es @Pesos(cuentas.Total).
                Revisa en el detalle los cobros por un valor distinto al servicio.
            </span>
        </div>
    }

        <!-- Desglose por ubicación -->
    <div class="section">

        <h2>
            <i class="fa-solid fa-location-dot"></i>
            Detalle por ubicación
        </h2>

        @foreach (var u in ViewBag.porUbicacion)
        {
            <details class="ubicacion-grupo">

                <summary>
                    <span>@u.Ubicacion</span>
                    <span>@u.Vehiculos vehículos</span>
                    <strong>$@(((decimal)u.Total).ToString("N0", pesosCO))</strong>
                </summary>

                @* Las clases liq-* ubican cada dato en el celular, donde cada vehículo se ve como un bloque *@
                <table class="liq-detalle">
                    <thead>
                        <tr>
                            <th>Placa</th>
                            <th>Hora</th>
                            <th>Cobró</th>
                            <th>Método</th>
                            <th>Cobrado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in u.Detalle)
                        {
                            decimal servicio = d.Valor, propina = d.Propina, cobrado = d.Cobrado;

                            <tr>
                                <td class="liq-placa">@d.Placa</td>
                                <td class="liq-hora">@(((DateTime?)d.Hora)?.ToString("dd/MM HH:mm"))</td>
                                <td class="liq-cobro">@d.Cobro</td>
                                <td class="liq-metodo">@d.Metodo</td>
                                <td class="liq-valor">
                                    @Pesos(cobrado)
                                    @* Lo que entró por ese carro y de qué se compone *@
                                    @if (propina > 0)
                                    {
                                        <span class="liq-desglose">servicio @Pesos(servicio) + propina @Pesos(propina)</span>
                                    }
                                    else if (cobrado != servicio)
                                    {
                                        <span class="liq-desglose liq-desglose-menos">servicio @Pesos(servicio): @Pesos(cobrado - servicio)</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </details>
        }

    </div>


    <!-- Valets -->
    <div class="section">

        <h2>
            <i class="fa-solid fa-user-dollar"></i>
            Efectivo recibido por valets
        </h2>

        <div class="alert-y">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>
                Verifique físicamente la entrega del dinero antes de confirmar la liquidación.
            </span>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Valet</th>
                    <th>Vehículos</th>
                    <th>Total efectivo</th>
                </tr>
            </thead>

            <tbody>
                @if (ViewBag.valets.Count > 0)
                {
                    foreach (var v in ViewBag.valets)
                    {
                        <tr>
                            <td>@v.NombreCompleto</td>
                            <td>@v.Vehiculos</td>
                            <td>@Pesos((decimal)v.TotalEfectivo)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3">No hay valets con efectivo pendiente</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="valet-total">
            <span>Total efectivo pendiente por validar:</span>
            <strong>@Pesos((decimal)ViewBag.totalValetsEfectivo)</strong>
        </div>

    </div>

    <!-- Confirmación -->
    <div class="confirm-card">

        <h2>Confirmar liquidación</h2>

        <p>
            Al confirmar esta liquidación se generará un registro permanente en el sistema.
        </p>

        <div class="conf-summary">

            <div class="ci">
                <div class="cl">Vehículos</div>
                <div class="cv">@ViewBag.totalVehiculos</div>
            </div>

            <div class="ci">
                <div class="cl">Transferencias</div>
                <div class="cv">@Pesos(cuentas.Transferencias)</div>
            </div>

            <div class="ci">
                <div class="cl">Propinas de QR</div>
                <div class="cv">@Pesos(-cuentas.Propinas)</div>
            </div>

            <div class="ci">
                <div class="cl">Efectivo a entregar</div>
                <div class="cv">@Pesos(cuentas.EfectivoAEntregar)</div>
            </div>

            <div class="ci total-card">
                <div class="cl">Total a liquidar</div>
                <div class="cv">@Pesos(cuentas.Total)</div>
            </div>

        </div>

        <div class="btn-row">

            <a class="btn btn-cancel" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-xmark"></i>
                Cancelar
            </a>

            <button class="btn btn-confirm" id="openModal">
                <i class="fa-solid fa-check"></i>
                Confirmar liquidación
            </button>
        </div>

    </div>

    <!-- Mensaje éxito -->
    <div class="success-banner" id="successBanner">
        <i class="fa-solid fa-circle-check"></i>
        <span>
            Liquidación confirmada exitosamente.
        </span>
    </div>

</div>

<!-- Modal -->
<div class="modal-wrap" id="modalWrap">

    <div class="modal-confirmar">

        <div class="modal-hdr">

            <div class="micon">
                <i class="fa-solid fa-shield-halved"></i>
            </div>

            <h3>Confirmar liquidación</h3>

        </div>

        <p>
            Está a punto de registrar esta liquidación.
            Esta acción no podrá deshacerse.
        </p>

        <div class="modal-rows">

            <div class="mrow">
                <span>Vehículos</span>
                <span>@ViewBag.totalVehiculos</span>
            </div>

            <div class="mrow">
                <span>Efectivo a entregar</span>
                <span>@Pesos(cuentas.EfectivoAEntregar)</span>
            </div>

            <div class="mrow">
                <span>Total a liquidar</span>
                <span>@Pesos(cuentas.Total)</span>
            </div>

        </div>

        <div class="modal-btns">

            <button class="btn btn-cancel" id="closeModal">
                Volver
            </button>

            <button class="btn btn-confirm"
                    id="doConfirm"
                    data-id-usuario="@idUsuario"
                    data-total-vehiculos="@ViewBag.totalVehiculos"
                    data-total-efectivo="@cuentas.EfectivoAEntregar"
                    data-total-transferencia="@cuentas.Transferencias"
                    data-total-dinero="@ViewBag.totalGeneral">
                Confirmar
            </button>

        </div>

    </div>

</div>