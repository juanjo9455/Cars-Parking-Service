<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="manifest" href="~/manifest.webmanifest" asp-append-version="true" />
    <meta name="theme-color" content="#b71c1c" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="CarsParking" />
    <link rel="apple-touch-icon" href="~/icons/icon-180.png" />
    <title>@ViewData["Title"] - CarsParkingService</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/vistakey.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    @* Rediseño: la letra (Overpass) y el sistema visual van de últimos para que manden sobre los estilos de antes *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Overpass:wght@400;600;700;800;900&display=swap" />
    <link rel="stylesheet" href="~/css/cps.css" asp-append-version="true" />
</head>
<body class="cps-app cps-key">

    @* Barra superior, barra inferior y hoja "Más" (antes, menú lateral): las mismas opciones por rol que en _Layout.
       Inicio quita el parqueadero escogido, como hacían "Vista Valet", "Panel Admin" y "Vista Banco" *@
    <partial name="_NavInferior" />

    @* Latido solo con actividad y cierre de sesión a la hora sin actividad *@
    <script src="~/js/inactividad.js" asp-append-version="true"></script>

    @RenderBody()

    @* Íconos Lucide y hoja "Más": antes que los demás scripts, para cambiar los íconos antes de pintar *@
    <script src="~/js/cps.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/pwa-register.js" asp-append-version="true"></script>
    <script src="~/js/sonidos.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

