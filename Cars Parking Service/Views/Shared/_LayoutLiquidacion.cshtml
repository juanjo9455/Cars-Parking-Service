@using Microsoft.AspNetCore.Http
@{
    var idRol = Context.Session.GetInt32("id_rol");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#b71c1c" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="CarsParking" />
    <link rel="apple-touch-icon" href="~/icons/icon-180.png" />
    <title>@ViewData["Title"] - CarsParkingService</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Liquidacion.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>

    @RenderBody()

    <script>
    setInterval(() => {
        fetch('/Home/KeepAlive', { 
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        }).catch(err => console.log('Error enviando latido:', err));
    }, 60000);
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/pwa-register.js" asp-append-version="true"></script>
    <script src="~/js/Liquidacion.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

