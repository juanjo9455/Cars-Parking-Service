@using Microsoft.AspNetCore.Http
@{
    var idRol = Context.Session.GetInt32("id_rol");
    var imagenUsuario = Context.Session.GetString("imagen_usuario_url");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="manifest" href="~/manifest.webmanifest" asp-append-version="true" />
    <meta name="theme-color" content="#b71c1c" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="CarsParking" />
    <link rel="apple-touch-icon" href="~/icons/icon-180.png" />
    <title>@ViewData["Title"] - CarsParkingService</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ingreso.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/solicitudes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Estado_Turnos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
    <div class="page-wrapper">
        @if (idRol == 1 || idRol == 3 || idRol == 4 || (idRol == 2 && (ViewBag.mostrarMenu ?? false)))
        {
                
            <aside class="menu-lateral-container" id="menu-lateral">
                <div class="div-cerrar-menu">
                    <i class="fa-solid fa-x" id="cerrar-menu-lateral"></i>
                </div>
                @* La foto también abre Mi perfil *@
                <a class="usuario" asp-controller="Home" asp-action="MiPerfil" title="Mi perfil" aria-label="Mi perfil" style="display: block; width: 2.8cm; height: 2.8cm;">
                    @if (!string.IsNullOrEmpty(imagenUsuario))
                    {
                        <img src="@imagenUsuario" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                    }
                    else
                    {
                        <i class="fa-solid fa-user"></i>
                    }
                </a>

                <div class="menu-lateral">
                    <ol>
                        @if (idRol == 2)
                        {

                            <li><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house"></i>Inicio</a></li>
                            <li><a asp-controller="Home" asp-action="Tabla_Vehiculos"><i class="fa-solid fa-table-list"></i>Tabla Ingresos</a></li>
                            <li><a asp-controller="Home" asp-action="Ingreso_Vehiculos"><i class="fa-solid fa-car-side"></i>Nuevo Ingreso</a></li>
                            <li><a asp-controller="Home" asp-action="VistaKey"><i class="fa-solid fa-square-parking"></i>Parqueaderos</a></li>

                        }
                        @if (idRol == 3)
                        {
                            <li><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house"></i>Inicio</a></li>
                            <li><a asp-controller="Home" asp-action="Tabla_Vehiculos"><i class="fa-solid fa-table-list"></i>Tabla Ingresos</a></li>
                            <li><a asp-controller="Home" asp-action="Estado_Turnos"><i class="fa-solid fa-user"></i>Estado Turnos</a></li>
                            <li><a asp-controller="Home" asp-action="Ingreso_Vehiculos"><i class="fa-solid fa-car-side"></i>Nuevo Ingreso</a></li>
                            <li><a asp-controller="Home" asp-action="VistaKey"><i class="fa-solid fa-square-parking"></i>Parqueaderos</a></li>
                            <li><a asp-controller="Home" asp-action="Administrador"><i class="fa-solid fa-gear"></i>Configuraciones Admin</a></li>
                            <!--<li><a asp-controller="Home" asp-action="WhatsAppEnviados"><i class="fa-brands fa-whatsapp"></i>WhatsApp Enviados</a></li>
                            <li><a asp-controller="Home" asp-action="DespachosCobros"><i class="fa-solid fa-receipt"></i>Despachos y cobros</a></li>-->

                        }
                        @if (idRol == 1)
                        {

                            <li><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house"></i>Inicio</a></li>
                            <li><a asp-controller="Home" asp-action="Tabla_Vehiculos"><i class="fa-solid fa-table-list"></i>Tabla Ingresos</a></li>
                            <li><a asp-controller="Home" asp-action="VistaKey"><i class="fa-solid fa-square-parking"></i>Parqueaderos</a></li>

                        }
                        @if ((idRol == 2 || idRol == 3) && (ViewBag.estadoLiquidacion ?? false) == false)
                        {
                            <li>
                                <a asp-controller="Liquidacion" asp-action="Liquidacion">
                                    <i class="fa-solid fa-sack-dollar"></i>Liquidación
                                </a>
                            </li>
                        }
                        @if (idRol == 3)
                        {
                            <li><a asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-chart-line"></i>Dashboard</a></li>
                        }
                        @* Sus datos y su contraseña: para todos los que tienen menú *@
                        <li><a asp-controller="Home" asp-action="MiPerfil"><i class="fa-solid fa-user-gear"></i>Mi perfil</a></li>
                        @if (idRol == 2)
                        {

                            @if ((ViewBag.estadoLiquidacion ?? false) == false)
                            {

                                <li><a id="cerrar-sesion" onclick="abrirModalAlerta()"><i class="fa-solid fa-right-from-bracket"></i>Cerrar Sesión</a></li>

                            }
                            else
                            {

                                <li><a asp-controller="Auth" asp-action="CerrarSesion" id="cerrar-sesion"><i class="fa-solid fa-right-from-bracket"></i>Cerrar Sesión</a></li>

                            }
                        }
                        else
                        {

                            <li><a asp-controller="Auth" asp-action="CerrarSesion" id="cerrar-sesion"><i class="fa-solid fa-right-from-bracket"></i>Cerrar Sesión</a></li>

                        }

                    </ol>
                </div>
            </aside>
            <div class="div-abrir-menu" id="div-abrir-menu">
                <i class="fa-solid fa-bars" id="abrir-menu-lateral"></i>
            </div>

        } 
        else
        {
         
            <div class="div-abrir-menu" id="volver-index">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn-volver-index">

                    <i class="fa-solid fa-house icon-home"></i>
                    <i class="fa-solid fa-arrow-left icon-back"></i>

                </a>
            </div>
            
        }

        @RenderBody()
    </div>

    @* Latido solo con actividad y cierre de sesión a la hora sin actividad *@
    <script src="~/js/inactividad.js" asp-append-version="true"></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/pwa-register.js" asp-append-version="true"></script>
    <script src="~/js/sonidos.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    @* Banco: vehículos sin cobrar de un banco cuyo turno ya terminó, para recibirlos (Database/turnos.sql) *@
    @if (idRol == 2)
    {
        <div id="recibir-vehiculos" class="recibir-modal" role="dialog" aria-modal="true" aria-labelledby="recibir-titulo" hidden>
            <div class="recibir-tarjeta">
                <h3 id="recibir-titulo"><i class="fa-solid fa-right-left"></i> Vehículos pendientes del turno anterior</h3>
                <p id="recibir-texto"></p>
                <div id="recibir-lista" class="recibir-lista"></div>
                <div class="recibir-botones">
                    <button type="button" class="btn btn-secondary" id="recibir-ahora-no">Ahora no</button>
                    <button type="button" class="btn btn-primary" id="recibir-aceptar">Sí, recibirlos</button>
                </div>
                @Html.AntiForgeryToken()
            </div>
        </div>

        <button type="button" id="recibir-aviso" class="recibir-aviso" hidden></button>

        <script src="~/js/recibir-vehiculos.js" asp-append-version="true"></script>
    }

</body>
</html>

