@using Microsoft.AspNetCore.Http
@{
    var idRol = Context.Session.GetInt32("id_rol");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="manifest" href="~/manifest.webmanifest" asp-append-version="true" />
    <meta name="theme-color" content="#b71c1c" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="CarsParking" />
    <link rel="apple-touch-icon" href="~/icons/icon-180.png" />
    <title>@ViewData["Title"] - CarsParkingService</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ingreso.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/solicitudes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Estado_Turnos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    @* Rediseño: la letra (Overpass) y el sistema visual van de últimos para que manden sobre los estilos de antes *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Overpass:wght@400;600;700;800;900&display=swap" />
    <link rel="stylesheet" href="~/css/cps.css" asp-append-version="true" />
</head>
<body class="@(idRol.HasValue ? "cps-app" : "")">
    @* Con sesión: barra superior, barra inferior y hoja "Más" (antes, menú lateral). Las opciones por rol son las mismas *@
    @if (idRol.HasValue)
    {
        <partial name="_NavInferior" />
    }

    <div class="page-wrapper">
        @RenderBody()
    </div>

    @* Íconos Lucide y hoja "Más": antes que los demás scripts, para cambiar los íconos antes de pintar *@
    <script src="~/js/cps.js" asp-append-version="true"></script>

    @* Latido solo con actividad y cierre de sesión a la hora sin actividad *@
    <script src="~/js/inactividad.js" asp-append-version="true"></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/pwa-register.js" asp-append-version="true"></script>
    <script src="~/js/sonidos.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    @* Banco: vehículos sin cobrar de un banco cuyo turno ya terminó, para recibirlos (Database/turnos.sql) *@
    @if (idRol == 2)
    {
        <div id="recibir-vehiculos" class="recibir-modal" role="dialog" aria-modal="true" aria-labelledby="recibir-titulo" hidden>
            <div class="recibir-tarjeta">
                <h3 id="recibir-titulo"><i class="fa-solid fa-right-left"></i> Vehículos pendientes del turno anterior</h3>
                <p id="recibir-texto"></p>
                <div id="recibir-lista" class="recibir-lista"></div>
                <div class="recibir-botones">
                    <button type="button" class="btn btn-secondary" id="recibir-ahora-no">Ahora no</button>
                    <button type="button" class="btn btn-primary" id="recibir-aceptar">Sí, recibirlos</button>
                </div>
                @Html.AntiForgeryToken()
            </div>
        </div>

        <button type="button" id="recibir-aviso" class="recibir-aviso" hidden></button>

        <script src="~/js/recibir-vehiculos.js" asp-append-version="true"></script>
    }

</body>
</html>

