@{
    ViewData["Title"] = "Estado del Servicio";

    // Plata con punto de miles ("20.000") sin importar el idioma del servidor
    var pesosCO = System.Globalization.CultureInfo.GetCultureInfo("es-CO");
}

@model ingresos

<div class="page-wrapper">
    <section class="servicio-section">
        <!-- Panel izquierdo: logo -->
        <div class="servicio-header">
            <div class="logo-container">
                <img src="~/img/Logo-CarsParkingService.png" class="logo-image" alt="Logo Cars Parking"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
                <!-- Fallback si no carga la imagen -->
                <div style="display:none; flex-direction:column; align-items:center; color:#fff;">
                    <div style="font-size:48px;">🚗</div>
                    <div style="font-family:'Syne',sans-serif; font-size:20px; font-weight:800; margin-top:8px;">Cars Parking</div>
                    <div style="font-size:13px; letter-spacing:3px; opacity:0.7; margin-top:2px;">SERVICE</div>
                </div>
            </div>
            <div class="header-badge">Parking Service</div>
        </div>

        <!-- Panel derecho: datos -->
        <div class="vehiculo">
            <h1 class="titulo-vehiculo">Mi Vehículo</h1>

            <!-- Tiempo de espera -->
            <div class="header-tiempo-confirmacion" id="tiempoEspera" style="display: none;">
                <div class="etiqueta-llegada-confirmacion">⏱ Tu vehículo llega en: <strong class="timer-display">08:00</strong></div>

                <div class="barra-track-confirmacion">
                    <div class="barra-fill-confirmacion"></div>
                </div>

                <div class="carro-container-confirmacion">
                    <span class="carro-icono">🚗</span>
                    <div class="ruta-puntitos">
                        <span></span><span></span><span></span><span></span><span></span>
                        <span></span><span></span><span></span><span></span><span></span>
                    </div>
                    <span class="destino-icono">📍</span>
                </div>
            </div>

            @* Después de solicitar: no cerrar la página, el valor, el método y el código de seguridad. Antes era la
               última pantalla de la ventana de pago. Al cargar lo llena el servidor; al solicitar, estado-servicio.js *@
            @{
                var metodoPago = string.IsNullOrEmpty(Model?.metodo_pago) ? "Efectivo" : Model.metodo_pago;
                var valorPagar = "$" + (Model?.total_servicio ?? 0).ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("es-CO"));
            }
            <div class="panel-espera" id="panel-espera" style="display:@(Model?.estado_pago == "solicitado" ? "flex" : "none")">
                <div class="confirmacion-header">
                    <h2 class="confirmacion-titulo">¡No cierres esta página!</h2>
                    <p class="confirmacion-sub">Acércate al valet para realizar el pago.</p>
                </div>

                <div class="panel-espera-valor">
                    <div>
                        <p class="panel-espera-valor-label">Valor a pagar</p>
                        <p class="panel-espera-valor-numero" id="confirmacion-total">@valorPagar</p>
                    </div>
                    <div style="font-size:36px;opacity:0.3;" aria-hidden="true">🧾</div>
                </div>

                <div class="tiempo-card" id="confirmacion-metodo-card">
                    <div class="tiempo-icono-wrap">
                        <span style="font-size:26px;" id="confirmacion-metodo-icono">
                            @if (metodoPago == "QR")
                            {
                                <i class="fa-solid fa-qrcode"></i>
                            }
                            else if (metodoPago == "Nequi")
                            {
                                <img src="~/img/nequi.ico" alt="" style="width:22px;height:22px;object-fit:contain;" />
                            }
                            else
                            {
                                <text>💵</text>
                            }
                        </span>
                    </div>
                    <div class="tiempo-info">
                        <p class="tiempo-label">Método de pago</p>
                        <p class="tiempo-valor" style="font-size:18px;" id="confirmacion-metodo-texto">@metodoPago</p>
                    </div>
                    <span style="font-size:20px;color:#27ae60;">✓</span>
                </div>

                @* El código lo muestra y lo actualiza estado-servicio.js (mostrarCodigoSeguridad / iniciarVerificacionCodigo) *@
                <div class="panel-codigo">
                    <p class="tiempo-label">Código de seguridad</p>
                    <p class="panel-codigo-ayuda">Aparece aquí cuando el valet vaya a cobrar. Muéstraselo para confirmar el pago.</p>

                    <div id="codigo-generado"
                         style="@(string.IsNullOrEmpty(Model?.codigo_seguridad) ? "display:none;" : "display:block;") background: #e8f5e9; padding: 15px; border-radius: 8px; text-align: center;">

                        <p style="margin: 0 0 10px 0; color: #444;">
                            <strong>Código de Seguridad Generado:</strong>
                        </p>

                        <p style="margin: 0;
                            font-size: 26px;
                            font-weight: bold;
                            color: #2e7d32;
                            font-family: monospace;"
                           id="codigo-valor">

                            @(Model?.codigo_seguridad ?? "------")

                        </p>

                        <p id="contador-codigo"
                           style="margin-top:10px;
                            color:#d32f2f;
                            font-weight:bold;">
                        </p>

                    </div>
                </div>
            </div>

            <p class="titulo-subtexto">Información del servicio activo</p>

            <ol class="descripcion-servicio">
                <li>
                    <p class="campo-label">Placa del Vehículo</p>
                    <h4 class="campo-valor">@Model?.placa</h4>
                </li>
                <li>
                    <p class="campo-label">Número Celular</p>
                    <h4 class="campo-valor">@Model?.telefono</h4>
                </li>
                <li id="lugar_entrega" style="display: none;">
                    <p class="campo-label">Lugar Entrega</p>
                    <h4 class="campo-valor" id="lugar_entrega_label">Sin Especificar</h4>
                </li>
                <li>
                    <p class="campo-label">Estado</p>
                    <h4 class="campo-valor" style="color:#e74c3c; display:flex; align-items:center; gap:6px;">
                        <span style="width:8px;height:8px;background:#e74c3c;border-radius:50%;display:inline-block;box-shadow:0 0 0 3px rgba(231,76,60,0.2)"></span>
                        @Model?.estado_servicio
                    </h4>
                </li>
            </ol>

            <input type="hidden" id="idIngreso" value="@Model?.id_ingreso" />
            <input type="hidden" id="fechaFinServicio" value="@Model?.fecha_fin_servicio?.ToString("o")" />

            @* Ya no hay botón "Solicitar Pago": el pago se elige al solicitar (lugar → pago → confirmar) *@
            @if (Model != null && CarsParkingService.Helpers.IngresoReglas.PuedeSolicitarse(Model))
            {
                @* Solo con valet asignado y sin despachar: un vehículo entregado no se vuelve a solicitar *@
                <button type="button" class="servicio-btn" id="btn-solicitar" style="display:block">
                    🚗 Solicitar Vehículo
                </button>
            }
        </div>
    </section>
</div>
<!-- ======= Modal Comfirmar Solicitud ======= -->
<div class="modal-confirmacion" id="modal-confirmacion" style="display: none;">
    <div class="informacion-solicitud" id="confirmacion">
        <div class="confirmacion" id="confirmacion">
            
        </div>
    </div>
</div>

<!-- ======= Modal Pedir viculo y Pagar ======= -->

<div class="modal-pagar oculto" id="modal-pagar">

    <!-- Resumen y pago: después de elegir el lugar de entrega. Su botón pide el carro (con confirmación) -->
    <div class="informacion" id="informacion_1"
         style="position:relative; display:block">
    <button type="button"
            aria-label="Cerrar"
            onclick="cerrarModalPagar()"
            class="btn-cerrar-modal"
            style="position:absolute;top:12px;right:12px;width:44px;height:44px;
        border:none;border-radius:50%;background:rgba(0,0,0,0.6);
        color:#fff;font-size:30px;line-height:1;z-index:20;cursor:pointer;">
        &times;
    </button>

        <div class="header-tiempo">
            <div class="conductor-section">
                <div class="conductor-avatar">👨‍✈</div>
                <div class="conductor-info">
                    <div class="conductor-nombre">@ViewBag.nombreUsuario</div>
                    <div class="conductor-detalle">
                        <span class="placa-tag">@Model?.placa</span>
                    </div>
                </div>
            </div>
        </div>
        <form method="post" asp-action="guardarPago">
            <input type="hidden" id="idIngresoForm" name="idIngreso" value="@Model?.id_ingreso" />
            <input type="hidden" id="tarifaValor" value="@((decimal?)ViewBag.tarifa ?? 0)" />
            <div class="resumen-titulo" style="padding: 16px 28px 0;">Resumen del viaje</div>
            <div style="padding: 0 28px;">
                <div class="resumen-fila">
                    <span>Tarifa base</span>
                    <span class="resumen-valor" id="tarifa-base" name="tarifa" value="@((decimal?)ViewBag.tarifa ?? 0)">$@(((decimal?)ViewBag.tarifa ?? 0).ToString("N0", pesosCO))</span>
                </div>
                <div class="resumen-fila propina-fila">
                    <div class="propina-label-container">
                        <span>Servicio Voluntario</span>
                    </div>
                    <span class="resumen-valor" name="propina">
                        <select class="input-group" id="select-propina">
                            <option value="0">$0.00</option>
                            <option value="1000">$1.000</option>
                            <option value="2000">$2.000</option>
                            <option value="5000">$5.000</option>
                            <option value="10000">$10.000</option>
                            <option value="20000">$20.000</option>
                            <option value="30000">$30.000</option>
                        </select>
                    </span>
                </div>
                <div class="resumen-total-fila">
                    <span class="total-label">Total a pagar</span>
                    <span class="total-valor" id="total-value" name="total">$@(((decimal?)ViewBag.tarifa ?? 0).ToString("N0", pesosCO))</span>
                </div>
            </div>

            <div class="pago-section">
                <div class="pago-titulo">Método de pago</div>
                <div class="metodos-grid" name="metodoPago">
                    <button type="button" class="metodo-btn activo" onclick="seleccionar(this)">
                        <span class="ico">💵</span>Efectivo
                    </button>   
                    <button type="button" class="metodo-btn" onclick="seleccionar(this)">
                        <span class="ico"><i class="fa-solid fa-qrcode"></i></span>QR
                    </button>
                    <button type="button" class="metodo-btn" onclick="seleccionar(this)">
                        <span class="ico">
                            <img src="~/img/nequi.ico" style="width:22px;height:22px;object-fit:contain;" />
                        </span>Nequi
                    </button>
                </div>
                <button class="btn-pagar" id="btn-confirmar-pago" type="button">
                    <span>🚗</span> Solicitar vehículo
                </button>
            </div>

        </form>

    </div>

    @* La pantalla de espera (no cerrar, valor, método y código) ahora está en la página: #panel-espera *@

</div>


@section Scripts {
    <script src="~/js/estado-servicio.js" asp-append-version="true"></script>
}
