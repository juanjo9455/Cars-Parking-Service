@{
    ViewData["Title"] = "Login";
}

<div class="login-container">

    <div class="logo-section">
        <div class="car-logo">
            <img src="~/img/logo cars parking.png" alt="Cars Parking Logo" class="logo-img">
        </div>
    </div>

        @if (ViewBag.MostrarRoles == true) {
            <h1 class="login-title">Ingresar al sistema</h1>

            <form method="post" asp-action="CambiarRol">

                <!-- SELECT DE ROLES -->
                <div class="input-group">

                    <select name="id_rol"
                            class="form-control"
                            id="selectRol"
                            onchange="mostrarCamposRol()">

                        @foreach (var rol in ViewBag.Roles)
                        {
                            <option value="@rol.id_rol">
                                @rol.nombre_rol
                            </option>
                        }

                    </select>

                </div>


                <!-- CONTENEDOR PARQUEADERO -->
                <div
                     id="contenedorParqueadero"
                     style="display:none;">

                    <select name="id_parqueadero" class="form-control">
                        <option value="" disabled selected hidden>
                            Selecciona un parqueadero
                        </option>
                        @foreach (var parqueadero in ViewBag.Parqueaderos)
                        {

                            <option value="@parqueadero.id_parqueadero">
                                @parqueadero.nombre_parqueadero
                            </option>
                        }

                    </select>

                </div>


                <!-- CONTENEDOR UBICACIONES -->
                <div
                     id="contenedorUbicacion"
                     style="display:none;">

                    <select name="id_ubicacion"
                            id="selectUbicacion"
                            class="form-control"
                            onchange="guardarUbicacionSesion(this.value)">

                        <option value="" disabled selected hidden>
                            Selecciona una ubicación
                        </option>
                        @foreach (var ubicacion in ViewBag.Ubicaciones)
                        {
                            <option value="@ubicacion.id_ubicacion">
                                @ubicacion.nombre_ubicacion
                            </option>
                        }

                    </select>

                </div>

                <button type="submit" class="login-btn">
                    Iniciar
                </button>

            </form>
        }
        else
        {
            <h1 class="login-title">Iniciar Sesión</h1>
            <form method="post" id="loginForm">
                @if (TempData["Mensaje"] != null)
                {
                    <div class="success-message">@TempData["Mensaje"]</div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="error-credenciales">
                        <span class="error-text">⚠️ @ViewBag.Error</span>
                    </div>
                }

                <div class="input-group">
                    <input type="text" id="dniLogin" placeholder="Usuario" name="dni">
                    <div class="error-message" id="errorDNI">⚠️ Ingresa un DNI válido</div>
                </div>

                <div class="input-group">
                    <input type="password" id="passwordLogin" placeholder="Contraseña" name="contraseña">
                    <div class="error-message" id="errorPassword">⚠️ La contraseña es obligatoria</div>
                </div>

                <button type="submit" class="login-btn" id="acceder">Ingresar</button>

            </form>
        }

    <div class="forgot-password">
        <a asp-controller="Auth" asp-action="ForgotPassword">¿Olvidaste tu contraseña?</a>
    </div>
</div>

<script>
    (function () {
        const spinnerSvg = '<svg viewBox="25 25 50 50"><circle r="20" cy="50" cx="50"></circle></svg>';

        const addSpinner = (el) => {
            if (!el || el.querySelector('.btn-spinner')) return;
            el.classList.add('btn-loading-target');
            const spinner = document.createElement('span');
            spinner.className = 'btn-spinner';
            spinner.setAttribute('aria-hidden', 'true');
            spinner.innerHTML = spinnerSvg;
            el.appendChild(spinner);
        };

        const getSpinnerColor = (el) => {
            const styles = window.getComputedStyle(el);
            const bg = styles.backgroundColor;
            const values = bg.match(/\d+(?:\.\d+)?/g);

            if (!values || bg === 'transparent') {
                return '#c62828';
            }

            const r = Number(values[0] || 0) / 255;
            const g = Number(values[1] || 0) / 255;
            const b = Number(values[2] || 0) / 255;
            const luminance = (0.2126 * r) + (0.7152 * g) + (0.0722 * b);

            return luminance > 0.72 ? '#c62828' : '#ffffff';
        };

        const activate = (el) => {
            if (!el) return;
            addSpinner(el);
            el.style.setProperty('--spinner-stroke', getSpinnerColor(el));
            el.classList.add('btn-loading');
            if (el.tagName === 'BUTTON') {
                el.disabled = true;
            }
        };

        const boot = () => {
            document.querySelectorAll('button, a.btn, a.home-action-btn').forEach(addSpinner);

            document.querySelectorAll('form').forEach(form => {
                form.addEventListener('submit', ev => {
                    const submitter = ev.submitter || form.querySelector('button[type="submit"], button:not([type])');
                    activate(submitter);
                });
            });

            document.querySelectorAll('a.btn, a.home-action-btn').forEach(link => {
                link.addEventListener('click', () => activate(link));
            });
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', boot);
        } else {
            boot();
        }
    })();
</script>
